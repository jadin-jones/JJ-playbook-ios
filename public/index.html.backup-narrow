:52px;height:52px;border-radius:50%;border:2px solid '+(latestA?assessBand(latestA.total).color:'rgba(255,255,255,.35)')+';background:rgba(255,255,255,.06);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;padding:0';\n      const C3=2*Math.PI*50, q3=latestA?Math.max(0,Math.min(1,latestA.total/ASSESS_MAX)):0;\n      v.meScoreValue=latestA?String(latestA.total):'—';\n      v.meScoreDash=(C3*q3).toFixed(1)+' '+(C3*(1-q3)+1).toFixed(1);\n      v.meScoreColor=latestA?assessBand(latestA.total).color:'rgba(255,255,255,.2)';\n      v.meScoreTitle=latestA?assessBand(latestA.total).label:'Not taken yet';\n      v.meScoreSub=latestA\n        ? (this.assessTakes().length>1\n            ? ((latestA.total-baseA.total>=0?'+':'')+(latestA.total-baseA.total)+' since your baseline · tap to review')\n            : 'Your baseline · tap to review line by line')\n        : 'Five minutes, ten lines, a score out of 100';\n      v.meScoreCardStyle='width:100%;display:flex;align-items:center;gap:14px;background:linear-gradient(150deg,#123663,#0C2647 62%,#0A1F3A);border:1px solid #1E4C7D;border-radius:14px;padding:15px 16px;margin-bottom:12px;cursor:pointer';\n    }\n    const AX=150,AY=10,BL=10,BR=290,BY=250;\n    const xAt=(y,side)=>{const t=(y-AY)/(BY-AY);return AX+(side*(BR-AX))*t;};\n    const byTier=t=>byRow(allMods.filter(m=>(m.tier||0)===t));\n    const onPyr=t=>byTier(t).filter(m=>m.pyramid!==false&&!partRoot(m));\n    const rows=[{y0:AY,y1:90,list:onPyr(3)},{y0:90,y1:170,list:onPyr(2)},{y0:170,y1:BY,list:onPyr(1)}];\n    const gSize=pyrGlobalSize(rows,xAt);\n    // The base row is held small by COMMUNICATION alone. Let every other block\n    // grow into its own cell up to the Lead Others size, so ENERGY, EXECUTE\n    // and E+R=O read at the same weight as CAST DIRECTION.\n    const midList=onPyr(2);\n    const targetSize=midList.length?pyrRowLayout(midList,90,170,midList.length,xAt,9.5).size:gSize;\n    const cells=[],labels=[],locks=[];\