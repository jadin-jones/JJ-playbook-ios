\n    }catch(e){ console.error('localNotify',e); }\n  }\n  // Tapping a notification lands them on the right screen, not the home page.\n  // `go` is one of: chat | updates | events | playbook | fund:<id>\n  handleDeepLink(go){\n    if(!go||this.state.role!=='leader') return;\n    if(go==='peer'){\n      this.setState({view:'score',tab:'assess'},()=>{\n        setTimeout(()=>{ try{ const el=document.getElementById('jj-peer-card');\n          if(el) window.scrollTo(0,Math.max(0,el.getBoundingClientRect().top+window.pageYOffset-70)); }catch(e){} },160); });\n      return;\n    }\n    if(go==='chat'||go==='updates'||go==='events'){\n      this.setState({view:'hub',tab:'hub',hubTab:go==='events'?'events':go},()=>this.markSeen(this.state.hubTab));\n    } else if(go.indexOf('fund:')===0){\n      const id=go.slice(5), m=this.modules().find(x=>x.id===id);\n      if(m&&this.fundUnlocked(m)) this.setState({view:'fund',tab:'playbook',fundId:id});\n      else this.setState({view:'home',tab:'playbook'});\n    } else {\n      this.setState({view:'home',tab:'playbook'});\n    }\n    try{ window.scrollTo(0,0); }catch(e){}\n  }\n  // Two ways in: a cold launch carries ?go= in the URL; a warm tap arrives as\n  // a postMessage from the service worker.\n  watchDeepLinks(){\n    if(this._dlWired) return; this._dlWired=true;\n    try{\n      const q=new URLSearchParams(location.search).get('go');\n      if(q){ this._pendingGo=q;\n        history.replaceState({},'',location.pathname); }\n    }catch(e){}\n    try{\n      navigator.serviceWorker.addEventListener('message',ev=>{\n        const d=ev&&ev.data;\n        if(d&&d.type==='jj-navigate'&&d.go) this.handleDeepLink(d.go);\n      });\n    }catch(e){}\n  }\n  // ---- Daily 6:00pm nudge to score the 5 S's ----\n  // Two belts: a local timer while the app is alive, and a flag on the push\n  // record so the server can reach a closed phone at 6pm in ITS timezone.\n  // Every timestamp this leader has ever saved, from any tool — the basis for\n  // the one overall consistency number the header and streak screen show.\n  allToolStamps(){\n    const r=this.state.resp; if(!r||!r.tools) return [];\n    const out=[];\n    Object.keys(r.tools).forEach(k=>{ ((r.tools[k]||{}).history||[]).forEach(h=>{\n      const t=h.ts||Date.parse(h.date); if(t) out.push(t); }); });\n    return out;\n  }\n  // ---- Playbook Assessment (Peer-Review) ----\n  async openPeerForm(token){\n    this.setState({booting:true,view:'peer',peerTokenIn:token});\n    const doc=await sget('peer:'+token);\n    this.setState({booting:false,view:'peer',peerRound:doc||null,\n      peerErr:doc?(doc.closed?'closed':''):'missing'});\n  }\n  async submitPeer(){\n    const d=this.state.peerDraft||{};\n    const missing=ASSESS.filter(a=>!d[a.k]);\n    if(missing.length) return this.toast('Score all '+ASSESS.length+' lines — '+missing.length+' left',true);\n    if(this.state.peerSaving) return;\n    this.setState({peerSaving:true});\n    const token=this.state.peerTokenIn;\n    // re-read so two people submitting at the same time don't overwrite each other\n    const doc=await sget('peer:'+token);\n    if(!doc||doc.closed){ return this.setState({peerSaving:false,peerErr:doc?'closed':'missing'}); }\n    doc.responses=(doc.responses||[]).concat([{ts:Date.now(),scores:Object.assign({},d),\n      keep:(this.state.peerKeep||'').slice(0,600),change:(this.state.peerChange||'').slice(0,600)}]);\n    const ok=await sset('peer:'+token,doc);\n    this.setState({peerSaving:false,peerDone:!!ok,peerRound:doc});\n    if(!ok) this.toast('Could not send that — try again',true);\n    else try{ window.scrollTo(0,0); }catch(e){}\n  }\n  peerRoundList(){ const r=this.state.resp; return ((r&&r.peerRounds)||[]).slice().sort((a,b)=>b.openedAt-a.openedAt); }\n  peerCurrent(){ const t=this.peerRoundList()[0]; return t?(this.state.peerDocs[t.token]||null):null; }\n  async loadPeerDocs(){\n    const list=this.peerRoundList(); if(!list.length) return;\n    const docs=Object.ass