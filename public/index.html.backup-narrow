ght:800;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#184E86;cursor:pointer\">{{ pinnedEditLabel }}<\/button>\n<\/div>\n<div style=\"display:grid;grid-template-columns:repeat({{ pinnedCols }},1fr);gap:9px\">\n<sc-for list=\"{{ pinned }}\" as=\"p\" hint-placeholder-count=\"3\">\n<button sc-camel-on-click=\"{{ p.onOpen }}\" style=\"{{ p.cardStyle }}\">\n<span style=\"position:relative;display:block;width:78px;height:78px;margin:0 auto\">\n<svg sc-camel-view-box=\"0 0 80 80\" style=\"width:78px;height:78px;display:block;transform:rotate(-90deg)\">\n<circle cx=\"40\" cy=\"40\" r=\"33\" fill=\"none\" stroke=\"rgba(255,255,255,.16)\" stroke-width=\"7\"><\/circle>\n<circle cx=\"40\" cy=\"40\" r=\"33\" fill=\"none\" stroke=\"{{ p.color }}\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-dasharray=\"{{ p.dash }}\" style=\"transition:stroke-dasharray 1s cubic-bezier(.22,.9,.3,1),stroke .5s ease\"><\/circle>\n<\/svg>\n<span style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:26px;line-height:1;color:#FFFFFF\">{{ p.value }}<\/span>\n<\/span>\n<span style=\"{{ p.runStyle }}\">{{ p.runLabel }}<\/span>\n<span style=\"display:block;font-size:9.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#FFFFFF;margin-top:9px;line-height:1.35\">{{ p.title }}<\/span>\n<span style=\"display:block;font-size:10.5px;color:#A9BDD6;margin-top:4px;line-height:1.45\">{{ p.streakLabel }}<\/span>\n<span style=\"{{ p.lifeStyle }}\">{{ p.lifeLabel }}<\/span>\n<\/button>\n<\/sc-for>\n<sc-for list=\"{{ pinnedSlots }}\" as=\"sl\" hint-placeholder-count=\"0\">\n<button sc-camel-on-click=\"{{ onEditPinned }}\" style=\"background:#0C2647;border:1.5px dashed #3D72AB;border-radius:16px;padding:16px 8px 14px;cursor:pointer;display:block\">\n<span style=\"display:flex;align-items:center;justify-content:center;width:78px;height:78px;margin:0 auto;border-radius:50%;border:2px dashed rgba(255,255,255,.3);fon