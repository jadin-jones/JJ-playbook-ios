x(0,Math.min(1,p)):0; return (C*q).toFixed(1)+' '+(C*(1-q)+1).toFixed(1); };\n      // Already logged this period? Decides whether the copy congratulates or\n      // nudges — nagging someone who has already shown up today is the fastest\n      // way to get them to stop showing up.\n      const loggedThisPeriod=(hh,unit)=>{\n        if(!hh.length) return false;\n        const from=periodStart(unit);\n        return hh.some(x=>{ const t=x.ts||Date.parse(x.date); return t&&t>=from; });\n      };\n      const ids=this.pinnedIds();\n      v.pinnedCols=String(Math.max(1,Math.min(3,ids.length)));\n      v.pinned=ids.map(id=>{\n        const m=this.mod(id), cfg=m.recurringTool;\n        const hh=(this.toolState(id).history)||[];\n        const unit=unitOf(m);\n        const c=!unit?0:(cfg.type==='frog'?frogStats(hh).streak:streakOf(hh,unit).current);\n        const word=unitWord(unit,1);\n        const mile=nextMile(c);\n        const doneNow=loggedThisPeriod(hh,unit);\n        const period=periodLabel(unit);\n        const nudge=(()=>{\n          if(!unit) return m.name;\n          if(!c) return hh.length?('One entry '+period+' starts a new streak')\n                                 :'Log your first and the streak begins';\n          if(doneNow) return (mile-c===1)?('Logged \\u00b7 one more and you hit '+mile+'!')\n                                        :('Logged '+period+' \\u00b7 '+(mile-c)+' more to hit '+mile);\n          return (c===1)?('Log '+period+' to make it 2 in a row')\n                        :('Keep it alive \\u2014 log '+period+' for '+(c+1));\n        })();\n        // The ring fills toward the next marker, and its color says where they\n        // are: red early, yellow on the way, green once it comes around.\n        const frac=unit?Math.max(0,Math.min(1,c/mile)):0;\n        const ringColor=!c?'rgba(255,255,255,.28)':(frac>=1?'#3E9E6A':(frac>=0.5?'#FADA01':'#D5502B'));\n        const bestRun=unit?(cfg.type==='frog'?frogStats(hh).streak:streakOf(hh,unit).best):0;\n\n        // A scored tool (the 5 S's and its kin) is better read as how well they\n        // are doing than as how many days in a row — the average carries both.\n        if(cfg.type==='tracker'){\n          const nums=hh.map(x=>Number(x.num!=null?x.num:x.total)).filter(n=>!isNaN(n));\n          const dimN=(cfg.dimensions||[]).length||5;\n          const max=dimN*(cfg.max||10);\n          const avg=nums.length?nums.reduce((a,b)=>a+b,0)/nums.length:0;\n          const q=max?avg/max:0;\n          const col=!nums.length?'rgba(255,255,255,.28)'\n            :(q>0.8?'#3E9E6A':(q>0.6?'#FADA01':(q>0.4?'#E08A2B':'#D5502B')));\n          const best=nums.length?Math.max.apply(null,nums):0;\n          return {title:cfg.title,\n            lifeLabel:nums.length?('Best '+best):'',\n            lifeStyle:nums.length?'display:block;font-size:9.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#7FADC9;margin-top:6px':'display:none',\n            value:nums.length?String(Math.round(avg)):'—',\n            runLabel:'daily average',\n            runStyle:'display:block;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-top:9px;color:'+(nums.length?col:'#8FADCB'),\n            color:col, dash:arc(q),\n            streakLabel:!nums.length?'Log your first score to see your average'\n              :(doneNow?('Scored '+period+' \\u00b7 '+nums.length+' entr'+(nums.length===1?'y':'ies')+' so far')\n                       :('Score '+period+' to keep the average honest')),\n            cardStyle:'background:'+(nums.length?'linear-gradient(150deg,#123663,#0C2647 62%,#0A1F3A)':'#0C2647')+';border:1px solid #1E4C7D;border-radius:16px;padding:16px 8px 14px;cursor:pointer;display:block',\n            onOpen:()=>this.go('tool',{toolFundId:id,toolFrom:'toolkit'})};\n        }\n        return {title:cfg.title,\n          lifeLabel:bestRun>c?('Best '+bestRun):'',\n          lifeStyle:bestRun>c?'display:block;font-size:9.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#7FADC9;margin-top:6px':'display:none',\n          value:unit?String(c):String(hh.length),\n          runLabel:unit?(word+(c===1?'':'s')+' in a row'):(hh.length===1?'entry saved':'entries saved'),\n          runStyle:'display:block;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-top:9px;color:'+(c?ringColor:'#8FADCB'),\n          color:ringColor, dash:arc(frac),\n          streakLabel:nudge,\n          cardStyle:'background:'+(c?'linear-gradient(150deg,#123663,#0C2647 62%,#0A1F3A)':'#0C2647')+';border:1px solid '+(c?'#1E4C7D':'#1E4C7D')+';border-radius:16px;padding:16px 8px 14px;cursor:pointer;display:block',\n          onOpen:()=>this.go('tool',{toolFundId:id,toolFrom:'toolkit'})};\n      });\n      // the top-right control carries adding now, so no placeholder tile\n      v.pinnedSlots=[];\n      v.pinnedEditLabel=ids.length<3?'Edit · Add':'Edit';\n      v.hasPinned=ids.length>0;\n      v.showPinPrompt=!ids.length&&this.modules().some(m=>m.recurringTool&&this.fundUnlocked(m));\n      v.onEditPinned=()=>this.go('toolkit',{tab:'toolkit'});\n      v.onOpenAudio=()=>this.go('audio',{tab:'me'});\n\n      // ---- Today: one number, every day. Share of daily actions logged, plus\n      // how healthy the streaks behind them are.\n      const dailyMods=this.dailyReminderMods();\n      const doneToday=dailyMods.filter(m=>this.toolLoggedToday(m)).length;\n      const strk=ids.map(id=>{ const m=this.mod(id), u=unitOf(m);\n        const hh=(this.toolState(id).history)||[];\n        return !u?0:(m.recurringTool.type==='frog'?frogStats(hh).streak:streakOf(hh,u).current); });\n      const avgStrk=strk.length?strk.reduce((a,b)=>a+b,0)/strk.length:0;\n      const health=Math.min(1,avgStrk/14);\n      const tScore=dailyMods.length\n        ? Math.round((doneToday/dailyMods.length)*70+health*30)\n        : Math.round(health*30);\n      const tColor=tScore>=80?'#3E9E6A':(tScore>=50?'#00A3E0':'#D