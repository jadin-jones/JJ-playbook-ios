Timeout(()=>this.setState({toast:''}),2800); }\n\n  async loadProgramFor(code){\n    const org=this.state.org&&this.state.org.code===code\n      ? this.state.org\n      : (this.state.orgList||[]).find(o=>o.code===code) || await sget('org:'+code);\n    const ed=this.orgEdition(org);\n    let master=await sget(progKey(ed));\n    if(!master&&ed==='y2') master=await sget(progKey('y1'));\n    if(!master) return null;\n    const ov=await sget(ovKey(ed,code));\n    if(!ov) return master;\n    const merged=JSON.parse(JSON.stringify(master));\n    (merged.modules||[]).forEach(m=>{ const o=ov[m.id]; if(!o) return;\n      if(o.challenge) m.challenge=Object.assign({},m.challenge,o.challenge);\n      if(o.overview!==undefined) m.overview=o.overview;\n      (m.items||[]).forEach(it=>{ const oi=o.items&&o.items[it.id]; if(!oi) return; Object.assign(it,oi); });\n    });\n    return merged;\n  }\n  // ---- Audiobook player ----\n  abPos(){ try{ return JSON.parse(localStorage.getItem(AB_POS_KEY)||'{}')||{}; }catch(e){ return {}; } }\n  abSavePos(p){ try{ localStorage.setItem(AB_POS_KEY,JSON.stringify(p)); }catch(e){} }\n  abKey(i){ return 'c'+(i+1); }\n  abStash(){\n    const a=this._ab; if(!a||!a.currentTime) return;\n    const p=this.abPos(); p[this.abKey(this.state.audioIdx||0)]={t:a.currentTime,d:a.duration||0}; this.abSavePos(p);\n  }\n  abMarkDone(i){\n    const r=this.state.resp; if(!r) return;\n    r.audio=r.audio||{};\n    if(r.audio[this.abKey(i)]&&r.audio[this.abKey(i)].done) return;\n    r.audio[this.abKey(i)]={done:true,at:Date.now()};\n    this.setState({resp:r}); this.saveResp();\n    this.toast('Chapter '+(i+1)+' finished');\n  }\n  abToggleDone(i){\n    const r=this.state.resp; if(!r) return;\n    r.audio=r.audio||{};\n    const was=!!(r.audio[this.abKey(i)]&&r.audio[this.abKey(i)].done);\n    if(was) delete r.audio[this.abKey(i)]; else r.audio[this.abKey(i)]={done:true,at:Date.now()};\n    this.setState({resp:r}); this.saveResp();\n    if(!was) this.toast('Chapter '