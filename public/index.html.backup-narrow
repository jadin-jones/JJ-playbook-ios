al=doc&&Array.isArray(doc.modules)&&doc.modules.length\n      && (ed==='y1' ? (doc.edition||'y1')==='y1' : doc.edition===ed);\n    this.setState({edition:ed, editionBusy:false, openModule:null, contentOrg:'', ovDraft:null,\n      draftProgram:real?JSON.parse(JSON.stringify(doc)):null});\n  }\n  // Year two starts as year one's format with empty lessons: the same nine\n  // fundamentals in the same order, fresh lesson ids so nobody's Y1 progress\n  // is read as Y2 progress, and the teaching content cleared for rewriting.\n  async seedEdition(){\n    const ed=this.state.edition||'y1'; if(ed==='y1') return;\n    const src=await sget(progKey('y1'));\n    if(!src) return this.toast('No Y1 program to copy the format from',true);\n    const d=JSON.parse(JSON.stringify(src));\n    d.edition=ed; d.title=(d.title||'The Playbook')+' '+edShort(ed); d.updatedAt=Date.now();\n    (d.modules||[]).forEach(m=>{\n      // Evergreen carries one module per fundamental: Lead Yourself.\n      if(ed==='ev'){ const keep=(m.items||[]).filter(it=>(it.kind||'learn')==='learn');\n        m.items=keep.length?[keep[0]]:(m.items||[]).slice(0,1); }\n      if(ed!=='ev') m.overview='';\n      if(ed!=='ev'&&m.challenge) m.challenge=Object.assign({},m.challenge,{title:'',body:''});\n      (m.items||[]).forEach(it=>{\n        it.id=ed+'-'+Math.random().toString(36).slice(2,10);\n        if(ed!=='ev'){ it.body=''; it.videoUrl=''; it.audioUrl=''; }\n        (it.questions||[]).forEach(q=>{ q.prompt=q.prompt||''; });\n      });\n    });\n    this.setState({draftProgram:d});\n    this.toast(edLabel(ed)+(ed==='ev'?' started as a full copy of Y1 — edit it freely':' started from the Y1 format — nothing is published yet'));\n  }\n\n  renderVals(){\n    const s=this.state, v={};\n    v.booting=s.booting;\n    v.hasToast=!!s.toast; v.toastMsg=s.toast;\n    v.toastStyle='position:fixed;left:50%;bottom:92px;transform:translateX(-50%);z-index:80;background:'+(s.toastErr?'#8F2D13':'#0C2647')+';color:#FFFFFF;padding:1