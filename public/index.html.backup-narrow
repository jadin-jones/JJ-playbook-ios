   r.seenFunds=seen;\n    this.setState({newFunds:fresh,resp:r});\n    if(Object.keys(fresh).length) this.saveResp();\n  }\n  // Live watch on the leader's peer-review link: a real notification the moment\n  // somebody replies, and the results card updates itself without a Refresh tap.\n  watchPeer(){\n    this.stopPeerWatch();\n    const t=this.peerRoundList()[0]; if(!t) return;\n    const db=fb(); if(!db) return;\n    let seen=null;\n    this._peerUnsub=db.collection(COLL).doc('peer:'+t.token).onSnapshot(d=>{\n      let doc=null; try{ doc=JSON.parse((d.data()||{}).value||'null'); }catch(e){}\n      if(!doc) return;\n      const n=((doc.responses)||[]).length;\n      const docs=Object.assign({},this.state.peerDocs); docs[t.token]=doc;\n      this.setState({peerDocs:docs});\n      if(seen===null){ seen=n; return; }\n      if(n>seen){\n        const added=n-seen; seen=n;\n        this.localNotify(added===1?'New peer response':added+' new peer responses',\n          {id:'peer-'+t.token+'-'+n, go:'peer',\n           body:n>=PEER_MIN?(n+' in — your results are unlocked.')\n             :(n+' of '+PEER_MIN+' in — '+(PEER_MIN-n)+' more unlocks your results.')});\n      } else seen=n;\n    },err=>console.error('peer watch',err));\n  }\n  stopPeerWatch(){ if(this._peerUnsub){ this._peerUnsub(); this._peerUnsub=null; } }\n  async deletePeerScores(){\n    const r=this.state.resp; if(!r||this.state.peerBusy) return;\n    this.setState({peerBusy:true});\n    for(const pr of ((r.peerRounds)||[])) await sdel('peer:'+pr.token);\n    this.stopPeerWatch();\n    r.peerRounds=[];\n    this.setState({resp:r,peerDocs:{},peerBusy:false,peerConfirmDelete:false});\n    await this.saveResp();\n    this.toast('Peer scores deleted');\n  }\n  async copyPeerLink(){\n    const cur=this.peerCurrent(); if(!cur) return;\n    const url=peerLink(cur.token);\n    try{ await navigator.clipboard.writeText(url); this.toast('Link copied'); }\n    catch(e){ this.toast(url); }\n  }\n  async sharePeerLink()