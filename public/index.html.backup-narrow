?|#|$)/.test(s)) return 'video/quicktime';\n  return 'video/mp4';\n}\nfunction embedUrl(u){\n  const s=String(u||'').trim(); if(!s) return '';\n  if(isDirectVideo(s)) return s;\n  // HubSpot hands out a watch page and a player URL; only the player embeds.\n  if(/(hs-sites|hubspotvideo|hubspot)\\.com/i.test(s)) return s.replace('/watch/','/embed/');\n  if(/drive\\.google\\.com|docs\\.google\\.com/.test(s)){\n    const id=driveId(s);\n    return id?('https://drive.google.com/file/d/'+id+'/preview'):s;\n  }\n  return s;\n}\n// Drive can render its own frame grab, which is the fallback when nobody has\n// set a thumbnail of their own.\nfunction driveThumb(u){ const id=driveId(u); return id?('https://drive.google.com/thumbnail?id='+id+'&sz=w1000'):''; }\nconst SK_ORDER=['learn','facilitate','checkin','discussion','reflection'];\nconst SK={learn:{label:'Lead Yourself',bg:'#0C2647'},facilitate:{label:'Lead Your Team',bg:'#6FC0EA'},checkin:{label:'Check-In',bg:'#2C74B3'},discussion:{label:'Team Discussion',bg:'#3E9E6A'},reflection:{label:'Monthly Reflection',bg:'#D4B400'}};\n/* ============================================================\n   YEAR 1 CONTENT\n   ------------------------------------------------------------\n   Fundamentals written out in full so Studio does not have to be\n   typed into field by field. Imported from the Content tab, merged\n   by name — an import updates the fundamental it matches and adds\n   the ones that are missing, so re-running it is safe.\n   All wording is the client's, verbatim.\n   ============================================================ */\nconst INS_SELF='Think about and record your personal reflection below.';\nconst INS_TEAM='Ask your team the question below and encourage them to share positive stories. This can be done as a group in a team or individual meeting. Add a summary of the conversations in the open text box below for future reference.';\nconst INS_CHECK='Record your answer as to how it relates to you.';\nconst INS_MONTH='Record your key observations related to the topic of this month.';\n/* Every fundamental follows the same spine: a Lead Yourself lesson carrying the\n   overview and the personal reflection, a Lead Your Team lesson for the group\n   conversation, then the check-in, team discussion and monthly reflection that\n   apply to it. Only the pieces the client actually wrote are included — where no\n   challenge or check-in was specified, none is invented. */\nfunction y1(name,iconKey,order,overview,parts){\n  const items=[];\n  items.push(Object.assign({kind:'learn', title:parts.selfTitle||name, len:'',\n    body:overview, instructionsTitle:'Instructions', instructions:INS_SELF,\n    questions:parts.self?[parts.self]:[]},\n    parts.challenge?{challenge:parts.challenge}:{}, parts.resource?{resource:parts.resource}:{}));\n  items.push(Object.assign({kind:'facilitate', title:parts.teamTitle||name, len:'',\n    body:overview, instructionsTitle:'Instructions', instructions:INS_TEAM,\n    questions:[]}, parts.challenge?{challenge:parts.challenge}:{}));\n  if(parts.checkin) items.push({kind:'checkin', title:'Challenge Check-In', len:'',\n    instructionsTitle:'Instructions',\n    instructions:parts.checkinNote||INS_CHECK, questions:[parts.checkin]});\n  if(parts.discussion) items.push({kind:'discussion', title:parts.discussionTitle||'Team Discussion', len:'',\n    instructionsTitle:'Instructions', instructions:INS_TEAM,\n    questions:Array.isArray(parts.discussion)?parts.discussion:[parts.discussion]});\n  if(parts.monthly) items.push(Object.assign({kind:'reflection', title:'Monthly Reflection', len:'',\n    instructionsTitle:'Instructions', instructions:parts.monthlyNote||INS_MONTH,\n    questions:Array.isArray(parts.monthly)?parts.monthly:[parts.monthly]},\n    parts.monthlyChoices?{choices:parts.monthlyChoices}:{}));\n  return {name, iconKey, tier:order===0?0:1, order:order+1, overview, items};\n}\nconst Y1_CONTENT=[\n  // Named exactly as it already exists in the program, so the import claims\n  // that fundamental and fills it in rather than standing a second one beside it.\n  y1('The Twin Thieves','twinthieves',0,\n    'Most people think success is about talent or hard work, but the real barriers are internal. The Twin Thieves—fear of failure and fear of judgment—hold people back more than any strategy ever could.\\n\\nSpot them. Challenge them. Don’t let them steal your best.',\n    {selfTitle:'The Twin Thieves', teamTitle:'The Twin Thieves',\n     self:'Recall a time when the Twin Thieves held you back from being the best version of yourself. How might things have turned out differently if you had recognized and overcome them?',\n     challenge:{title:'Be the Buffalo',\n       desc:'What are storms that might be coming? What does it look like to Be the Buffalo and run into the storm?'},\n     checkin:'Where do I need to be the buffalo and take a challenge head on?',\n     discussionTitle:'Team Reflection',\n     discussion:'What is one example where you recently saw a team member being the Buffalo?',\n     monthly:'What did I observe within myself and the team this month?'}),\n\n  y1('Fundamental #1: Energy','energy',1,\n    'A lot of people overlook the power of energy. Most teams get caught up in strategy, tools, or new tactics…but they forget…that an okay strategy with incredible energy is always more powerful than a great strategy with low energy.\\n\\nShow up your best to inspire others to be their best.',\n    {self:'Score yourself on each of the 5 S’s and calculate your total. Share your total below, then identify your lowest area and outline a simple plan to raise it by one or two points.\\n\\nReminder, the 5 S’s are:\\n● Sleep\\n● Sweat\\n● Structure\\n● Social\\n● Stillness',\n     resource:{title:'Track Your 5 S’s',\n       url:'https://docs.google.com/spreadsheets/d/1n_eGKk4yoDaibbJpGDCrnFB_LZHKNoAUMERoMO7M_0g/edit?usp=sharing',\n       note:'As you watch, think about how you would score yourself in each category. Then use this link to begin tracking your 5 S’s. We will ask for your avg. score in two weeks.',\n       enabled:true},\n     discussion:'As you have been focusing on your energy and tracking your 5 S’s, what positive changes have you noticed?',\n     monthly:'What was your average this week when it comes to the 5 S’s? (No 7’s Allowed)',\n     monthlyChoices:['Sleep','Sweat','Structure','Social','Stillness']}),\n\n  y1('Fundamental #2: Execute','execute',2,\n    'Most people think execution is about knowing what to do, but the real challenge is doing it consistently—especially when it’s hard.',\n    {self:'What is one ‘frog’ that you can eat for breakfast tomorrow?',\n     challenge:{title:'Monthly Challenge',\n       desc:'#1: Don’t let your days go by default\\n#2: Circle the most important frog you have to attack.'},\n     checkin:'What is one “frog” you ate this week, a task you didn’t want to do but tackled anyway to move forward? How did you feel once it was done?',\n     discussionTitle:'Team Reflection',\n     discussion:'What improvements have you noticed as a team, as you’ve started scheduling your day? What are some of the ‘frogs’ team members have identified that still need to be tackled?',\n     monthly:['What did you notice in yourself or your team when you approached this month with an ‘Eat the Frog’ mindset?',\n       'Who deserves a shout out for an ‘Eat the Frog’ moment, big or small?',\n       'If you have any feedback, we’d love to hear what you’ve enjoyed about the program or any ideas you have to make it even better.']}),\n\n  y1('Fundamental #3: E+R=O','ero',3,\n    'Success is not just about talent or effort. It is about how we respond when things do not go as planned. E+R=O stands for Event plus Response equals Outcome. We cannot control every event, but we can control how we respond. The most successful leaders do not let fear or emotion drive their response. They pause, choose with intention, and take ownership of the outcome.\\n\\nTrain it. Practice it. Own the response.',\n    {self:'Think of a situation that didn’t end the way you wanted it to. How might applying E+R=O have changed your response and potentially the outcome?',\n     resource:{title:'Reverse Engineering the E+R=O',\n       url:'https://docs.google.com/document/d/1wy05ikKCYqbKg7sM3l2rs354Zs2q2Gb8vyKe5-FwKF8/edit?tab=t.0',\n       note:'As you watch, please consider some potential outcomes you’re after, and how you can use reverse engineering of E+R=O to help you overcome any events along the way.',\n       enabled:true},\n     discussion:'What positive changes have you noticed as a team by using E+R=O? Please share a situation where your team chose an intentional response that led to a better outcome.',\n     monthly:'How did your outcome change when you focused on what you could control rather than the event itself?'}),\n\n  y1('Fundamental #4: Principle-Based','principle',4,\n    'Great leadership isn’t driven by power, popularity, or position, it’s anchored in principles. Principle-Based Leadership means acting with integrity, clarity, and consistency, even when it’s hard. Leaders grounded in principles don’t just react...they lead with values, make decisions rooted in truth, and earn trust by how they show up.\\n\\nPrinciples don’t shift with pressure. They guide us when circumstances change. When things get tough, principle based leaders stay steady; not because it’s easy, but because it’s right.\\n\\nLive it. Lead with it. Be the example.',\n    {self:'Think of a time when emotions influenced your response more than your principles. How might leading with principles instead of feelings have changed your response and the result?',\n     resource:{title:'Building Your Principle Pentagon',\n       url:'https://drive.google.com/file/d/1lf3uM7HASQt-Y39WI_pWXGxM1GEBTgs7/view',\n       note:'As you watch, please be thinking about what principles might be included on your pentagon.',\n       enabled:true},\n     checkinNote:'As leaders, we challenged ourselves and our teams to act with integrity, clarity, and consistency. By returning to what matters most, we built trust, aligned our actions with our beliefs, and created momentum through disciplined, principle-driven decisions.\\n\\nPlease take a moment to reflect on the question below.',\n     checkin:'Looking ahead to the new year, which of your principles will require you to be the most intentional?',\n     discussionTitle:'Team Reflection',\n     discussion:'How do you think the team would improve if decisions were based more on principles than emotions?',\n     monthlyNote:'This past month, our focus was on leading with principles and making decisions grounded in core values rather than emotions, pressure, or convenience.\\n\\nAs leaders, we challenged ourselves and our teams to act with integrity, clarity, and consistency. By returning to what matters most, we built trust, aligned our actions with our beliefs, and created momentum through disciplined, principle-driven decisions.\\n\\nPlease take a moment to reflect on the question(s) below.',\n     monthly:['What did you notice in yourself or your team when leading based on principles?',\n       'Who deserves a shout out for a principle-based action, big or small?']}),\n\n  y1('Fundamental #5: Incredible Communication','comm',5,\n    'Great leaders are great listeners. They don’t just hear — they seek to understand. Incredible communication starts with presence, not performance. It’s about creating space for others, asking better questions, and responding with clarity and care.\\n\\nThe most trusted leaders listen more than they speak. They make people feel seen, heard, and valued — and that’s what moves teams forward.\\n\\nListen first. Lead with clarity. Build trust through every conversation.',\n    {selfTitle:'Becoming A Great Listener', teamTitle:'Becoming A Great Listener',\n     self:'Which level of listening do you tend to fall into most often, and what would it take to show up as an empathetic listener more consistently?',\n     challenge:{title:'Becoming A Great Listener',\n       desc:'As you watch, please be thinking about where your tendencies lean the most to: Distracted Listening, Selfish Listening, or Empathetic Listening.'},\n     discussion:'What is one thing that helps you avoid being a distracted listener, and how has empathetic listening improved your conversations?',\n     monthly:'What did you notice in yourself or your team when you focused on empathetic listening, and who deserves a shout-out for making someone feel truly heard and understood?'}),\n\n  y1('Fundamental #5: Incredible Communication — C.L.E.A.R.','comm',6,\n    'Great leaders speak with clarity. C.L.E.A.R. communication means getting to the point, removing confusion, and delivering your message with purpose.\\n\\nIt’s not about saying more it’s about saying what matters.\\n\\nBe clear. Say what you mean. Help others move forward.',\n    {selfTitle:'Becoming A Great Communicator', teamTitle:'Becoming A Great Communicator',\n     self:'As you reflect on C.L.E.A.R. communication, where are you most effective today and where do you want to improve?',\n     challenge:{title:'Becoming A Great Communicator',\n       desc:'As you watch, please consider who might provide you with constructive feedback to support your growth as a communicator.'},\n     discussion:'What kind of feedback did you receive, and were there any surprises? How will you take the feedback and improve in that area?',\n     monthly:'What did you notice in yourself or your team when you focused not just on what was being said, but on how well you were communicating it?'}),\n\n  y1('Fundamental #6: Cast Direction','cast',7,\n    'Great leaders give clear direction.\\n\\nCasting direction means helping others see where we’re going, why it matters, and how they can contribute.\\n\\nIt’s not about control. It’s about clarity, alignment, and shared purpose.\\n\\nPoint the way. Create alignment. Move with intention.',\n    {selfTitle:'Leading The Direction Forward', teamTitle:'Leading The Direction Forward',\n     self:'As you reflect on Casting Direction, where is your direction working well and where does it need more clarity?',\n     discussion:'Where have you seen a team member positively transferring belief?',\n     monthly:'What stood out to you most while focusing on casting direction?'}),\n\n  y1('Fundamental #7: Build Trust','trust',8,\n    'Great leaders earn trust. Building trust means showing consistency, keeping your word, and creating an environment where people feel secure and respected.\\n\\nBe consistent. Do what you promise. Help others feel safe to succeed.',\n    {self:'As you reflect on Building Trust, where are you doing well and where do you want to improve?',\n     resource:{title:'Completing the Trust Bank',\n       url:'https://drive.google.com/file/d/1-LgI63R0VefTPCqxyRomYp6QtqlWc4jQ/view',\n       note:'This week, we’re going to ask you to complete the Trust Bank individually. During the Watch With Team portion next week, you will be prompted to think about and complete the same Trust Bank handout as a collective group.',\n       enabled:true},\n     discussion:['What are a few deposits we’ve made recently that strengthened trust on our team?',\n       'What kinds of withdrawals do we want to be more mindful of going forward?'],\n     monthly:'What stood out to you most while reflecting on how your team makes deposits and withdrawals in the Trust Bank?'}),\n\n  y1('Fundamental #8: Fast Feedback','feedback',9,\n    'Great leaders catch champions.\\n\\nThey notice the people who go above the standard — who give extra effort, elevate others, and raise the bar for what’s possible.\\n\\nCatching champions isn’t just about recognition — it’s about reinforcing what right looks like and multiplying excellence across the team.\\n\\nWhen you catch a champion, you shine a light on what you want repeated.',\n    {selfTitle:'Catching Champions', teamTitle:'Catching Champions',\n     self:'How intentional are you about recognizing those who go above the standard, and how could faster, more specific feedback strengthen your team?',\n     checkin:'Who is someone you identified as a champion and what specifically did you do to recognize them for their positive behavior?',\n     discussion:'Who is a champion you could recognize within this team and why?',\n     monthly:'What have you noticed by being more intentional about catching champions?'}),\n\n  y1('Fundamental #8: Fast Feedback — Crucial Conversations','feedback',10,\n    'Crucial conversations are the tough talks that really matter — the ones with high stakes, strong emotions, and different opinions.\\n\\nThese moments have the power to shape relationships, influence decisions, and build or break trust.\\n\\nThey test a leader’s honesty, courage, and ability to stay grounded under pressure. When handled well, crucial conversations lead to understanding and progress. When handled poorly, they create tension and distance.',\n    {selfTitle:'Crucial Conversations', teamTitle:'Crucial Conversations',\n     self:'Who is one person you need to have a crucial conversation with, and what would a successful outcome look like?',\n     discussion:'What helps a crucial conversation feel safe and productive on this team, and what gets in the way?',\n     monthly:'What did you notice as you leaned into having crucial conversations, instead of avoiding them?'}),\n\n  y1('Fundamental #9: Starfish Moments','starfish',11,\n    'Starfish moments are the small actions that make a big difference.\\n\\nThey’re the times when you take a moment to help, encourage, or show kindness — and it sticks.\\n\\nThese moments build connection, trust, and lasting impact.\\n\\nThey remind us that one simple act can impact someone’s day — or even their life.',\n    {self:'Think of a Starfish Moment someone created for you. What did they do, and how can you use that as a model for how you lead and support others?',\n     checkin:'When have you made a small effort that made a big difference for someone else?',\n     discussion:'Think of a moment when someone’s simple act of help or kindness made a lasting difference for you. What exactly did they do, and how did it make you feel?',\n     monthly:'What did you learn by focusing on Starfish Moments, and how can you be more intentional about creating them moving forward?'})\n];\n// The Playbook Signature Assessment — ten statements, 1–10, no 7s (the missing\n// middle forces a real call). Ten lines x 10 = a score out of 100. Fast Feedback\n// carries two lines, which is why there are ten rows against nine fundamentals.\nconst ASSESS=[\n  {k:'energy',   fund:'energy',   label:'Energy',                             stmt:'I bring great, consistent energy that fuels my team to be its best.'},\n  {k:'execute',  fund:'execute',  label:'Execute',                            stmt:'I prioritize and execute the top priorities.'},\n  {k:'ero',      fund:'ero',      label:'E+R=O',                              stmt:'I adapt and respond well to challenges.'},\n  {k:'principle',fund:'principle',label:'Principle Based',                    stmt:'I have clear principles and make consistent, principle based decisions.'},\n  {k:'comm',     fund:'comm',     label:'Incredible Communication',           stmt:'I communicate with clarity, empathy and speed, and I avoid vague, uncommitted language.'},\n  {k:'cast',     fund:'cast',     label:'Cast Direction',                     stmt:'I clearly communicate the direction we are going, and I am excited about it too.'},\n  {k:'trust',    fund:'trust',    label:'Build Trust',                        stmt:'I am connected and have high trust with the people I lead.'},\n  {k:'champions',fund:'feedback', label:'Fast Feedback: Catch Champions',     stmt:'I celebrate and recognize people doing a great job.'},\n  {k:'tough',    fund:'feedback', label:'Fast Feedback: Tough Conversations', stmt:'I have the tough conversations to keep our standards high.'},\n  {k:'starfish', fund:'starfish', label:'Starfish Moments',                   stmt:'I serve others and create memorable moments for our customers.'}\n];\nconst ASSESS_SCALE=[1,2,3,4,5,6,8,9,10];\nconst ASSESS_MAX=ASSESS.length*10;\nconst REASSESS_DAYS=90;\n// Bands give the number meaning at a glance, the way a recovery color does.\nconst ASSESS_BANDS=[\n  {min:85,label:'Championship',  color:'#3E9E6A', note:'This is a team operating at the standard. Protect it.'},\n  {min:70,label:'Strong',        color:'#00A3E0', note:'Solid ground. The gains now come from your two weakest lines.'},\n  {min:55,label:'Building',      color:'#D4B400', note:'The foundation is going in. Pick one line and move it.'},\n  {min:0, label:'Needs a plan',  color:'#D5502B', note:'Honest scoring here is the win. Start with the lowest line.'}\n];\nfunction assessBand(total){ const p=Math.round(total/ASSESS_MAX*100);\n  return ASSESS_BANDS.find(b=>p>=b.min)||ASSESS_BANDS[ASSESS_BANDS.length-1]; }\n/* ---- Playbook Assessment (Peer-Review) ----\n   The same ten lines, reworded so somebody being led scores the team from the\n   inside. The leader shares a link carrying a one-round token; nobody signs\n   in and nothing is installed. Anonymity is structural rather than promised:\n   no response surfaces to the leader until PEER_MIN have arrived, and even\n   then only averages and unattributed comments are ever readable. */\nconst PEER=[\n  {k:'energy',   label:'Energy',                             stmt:'This leader brings great, consistent energy that fuels the team to be its best.'},\n  {k:'execute',  label:'Execute',                            stmt:'This leader prioritizes and executes the top priorities.'},\n  {k:'ero',      label:'E+R=O',                              stmt:'This leader adapts and responds well to challenges.'},\n  {k:'principle',label:'Principle Based',                     stmt:'This leader has clear principles and makes consistent, principle based decisions.'},\n  {k:'comm',     label:'Incredible Communication',           stmt:'This leader communicates with clarity, empathy and speed, and avoids vague, uncommitted language.'},\n  {k:'cast',     label:'Cast Direction',                      stmt:'This leader clearly communicates the direction we are going, and is excited about it too.'},\n  {k:'trust',    label:'Build Trust',                         stmt:'This leader is connected and has high trust with the people they lead.'},\n  {k:'champions',label:'Fast Feedback: Catch Champions',      stmt:'This leader celebrates and recognizes people doing a great job.'},\n  {k:'tough',    label:'Fast Feedback: Tough Conversations',  stmt:'This leader has the tough conversations to keep standards high.'},\n  {k:'starfish', label:'Starfish Moments',                    stmt:'This leader serves others and creates memorable moments for our customers.'}\n];\nconst PEER_OPEN=[\n  {k:'keep',   q:'What is one specific thing this person is doing well that they should continue?', ph:'Be specific — one thing, not a list.'},\n  {k:'change', q:'What is one specific thing this person could improve to be the best leader possible?', ph:'Be direct — nobody will know who wrote this.'}\n];\nconst PEER_MIN=3;\nconst ADMIN_WRITE_PW='JadinJones1';\n// no O/0, I/1, S/5, B/8 — these get read aloud and typed by hand\nconst PEER_ALPHA='ACDEFGHJKLMNPQRTUVWXY34679';\nfunction peerToken(){ let s=''; for(let i=0;i<6;i++) s+=PEER_ALPHA[Math.floor(Math.random()*PEER_ALPHA.length)]; return s; }\nfunction peerLink(t){ try{ return location.origin+location.pathname+'?r='+t; }catch(e){ return '?r='+t; } }\nfunction peerAgg(doc){\n  const rs=(doc&&doc.responses)||[];\n  if(!rs.length) return {n:0,avg:{},total:0,open:[]};\n  const avg={};\n  ASSESS.forEach(a=>{ const ns=rs.map(r=>(r.scores||{})[a.k]).filter(n=>typeof n==='number');\n    avg[a.k]=ns.length?ns.reduce((x,y)=>x+y,0)/ns.length:null; });\n  return {n:rs.length, avg,\n    total:Math.round(ASSESS.reduce((n,a)=>n+(avg[a.k]||0),0)),\n    open:rs.map(r=>({keep:(r.keep||'').trim(),change:(r.change||'').trim()}))};\n}\nconst TIER_LABEL={0:'Introduction',1:'Level 1: Lead Yourself',2:'Level 2: Lead Others',3:'Level 3: Servant Leadership'};\n\nlet _db=null;\nfunction fb(){ try{ if(_db) return _db; if(typeof firebase==='undefined') return null;\n  if(!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);\n  _db=firebase.firestore();\n  /* Phones on carrier data, hotel wifi and corporate proxies often break\n     Firestore's default streaming transport: the connection opens, then stalls\n     until our timeout fires and sign-in looks \"offline\" on a full signal.\n     Auto-detect falls back to long-polling when that happens. Local\n     persistence then makes every later read instant and survives a dropout. */\n  try{ _db.settings({experimentalAutoDetectLongPolling:true,merge:true}); }catch(e){}\n  try{ _db.enablePersistence({synchronizeTabs:true}).catch(()=>{}); }catch(e){}\n  return _db; }catch(e){ return null; } }\nfunction withTimeout(p,ms){ let t; return Promise.race([\n  Promise.resolve(p).then(v=>{ clearTimeout(t); return v; },e=>{ clearTimeout(t); throw e; }),\n  new Promise((_,r)=>{ t=setTimeout(()=>r(new Error('timeout')),ms); })]); }\n/* One slow read should not end the attempt. Try again, briefly backing off,\n   before anyone is told the network is at fault. */\nasync function attempt(fn,tries,ms){\n  let last;\n  for(let i=0;i<tries;i++){\n    try{ return await withTimeout(fn(),ms); }\n    catch(e){ last=e; if(i<tries-1) await new Promise(r=>setTimeout(r,400*(i+1))); }\n  }\n  throw last;\n}\n/* Every successful read is mirrored locally, so a later dropout can be served\n   from the last known copy instead of a failure. */\nfunction cacheGet(key){ try{ const raw=localStorage.getItem('jjc:'+key); return raw==null?undefined:JSON.parse(raw); }catch(e){ return undefined; } }\nfunction cachePut(key,val){ try{ localStorage.setItem('jjc:'+key,JSON.stringify(val)); }catch(e){} }\nasync function sget(key){ try{ const db=fb(); if(db){\n    try{ const d=await attempt(()=>db.collection(COLL).doc(key).get(),3,8000);\n      const v=d.exists?JSON.parse(d.data().value):null; cachePut(key,v); return v; }\n    catch(e){ const c=cacheGet(key); if(c!==undefined){ console.warn('sget cached',key); return c; } throw e; } }\n  const raw=localStorage.getItem('jj:'+key); return raw==null?null:JSON.parse(raw); }catch(e){ console.error('sget',key,e); return null; } }\n/* Same read, but it tells the difference between “no such record” (null) and\n   “could not reach the database” (throws). Sign-in uses this: a timeout must\n   never look like a new leader, or we would write a blank profile over their\n   history the next time anything saves. */\nasync function sgetStrict(key){\n  const db=fb();\n  if(db){ const d=await attempt(()=>db.collection(COLL).doc(key).get(),3,8000);\n    const v=d.exists?JSON.parse(d.data().value):null; cachePut(key,v); return v; }\n  const raw=localStorage.getItem('jj:'+key); return raw==null?null:JSON.parse(raw);\n}\nasync function sset(key,val){ try{ const s=JSON.stringify(val); const db=fb(); if(db){ cachePut(key,val);\n    await attempt(()=>db.collection(COLL).doc(key).set({value:s}),2,9000); return true; }\n  localStorage.setItem('jj:'+key,s); return true; }catch(e){ console.error('sset',key,e); return false; } }\nasync function sdel(key){ try{ const db=fb(); if(db){ await withTimeout(db.collection(COLL).doc(key).delete(),9000); return true; }\n  localStorage.removeItem('jj:'+key); return true; }catch(e){ console.error('sdel',key,e); return false; } }\nasync function slist(prefix){ try{ const db=fb(); if(db){ const snap=await withTimeout(db.collection(COLL).get(),12000);\n    return snap.docs.map(d=>d.id).filter(k=>k.indexOf(prefix)===0); }\n  return Object.keys(localStorage).filter(k=>k.indexOf('jj:')===0).map(k=>k.slice(3)).filter(k=>k.indexOf(prefix)===0); }catch(e){ console.error('slist',e); return []; } }\n\nconst slug=s=>String(s).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,60);\n\n/* ---- Company values ----------------------------------------------------\n   An organization arrives with its own language. Rather than asking people to\n   hold two frameworks at once, each value is anchored to the fundamentals it\n   already lives in, so the Playbook reads in their words. Shape:\n     {name, edge, statement, behaviors[], commitments[], funds[]}\n   `edge` is the optional leader-commitment name a value travels under.\n   Presets are starting points — every field stays editable per organization. */\nconst VALUE_PRESETS={\n  usv:{\n    label:'U.S. Venture — EDGE',\n    values:[\n      {name:'Caring Relationships', edge:'Empower', color:'#8A9A1D',\n       statement:'We approach relationships with inclusion, compassion, curiosity, and humility to build and become our best authentic selves.',\n       behaviors:['Show compassion and empathy','Respect diverse perspectives','Celebrate achievements','Assume positive intent','Prioritize personal connections','Give generously with your time and talents'],\n       commitments:['I build strong, personal connections through regular, focused check-ins.','I delegate at the appropriate level and remove barriers to empower my team to succeed.','I lead with humility, empathy and self-awareness, staying mindful of my presence and its impact on others.','I foster trust by creating a safe, respectful space where team members feel heard, valued, and supported.'],\n       funds:['trust','starfish']},\n      {name:'Entrepreneurial Spirit', edge:'Disrupt', color:'#EFB024',\n       statement:'We believe our unique combination of innovation and risk mitigation empowers us to Find a Better Way.',\n       behaviors:['Drive change and innovation','Challenge the status quo','Learn from successes and failures','Take a calculated chance','Be humble'],\n       commitments:['I spark curiosity by inviting ideas, modeling continuous learning and encouraging my team to Find a Better Way.','I treat failures as part of learning and support smart risk-taking.','I lead through change with agility and help others thrive in it.','I challenge the status quo by asking bold questions and inspiring others to reimagine what’s possible.'],\n       funds:['ero','energy']},\n      {name:'Strategic Foresight', edge:'Guide', color:'#1F3A7A',\n       statement:'We create our road map to win by considering possibilities beyond our normal line of sight.',\n       behaviors:['Set ambitious goals','Focus on the long term','Leverage data to drive decisions','Maintain a growth mindset','Share transparently and communicate strategy broadly'],\n       commitments:['I connect daily work to our broader strategy and goals.','I communicate clearly and often to provide clarity.','I provide direction that keeps us aligned and focused.','I champion development by opening doors to growth and opportunity, helping team members expand their impact.'],\n       funds:['cast','comm']},\n      {name:'High Performance', edge:'Execute', color:'#E4232A',\n       statement:'We own the challenge to deliver exceptional performance and dare to be the very best in the marketplace.',\n       behaviors:['Take swift, decisive action','Measure what matters','Support decisions once made','Hold yourself and others accountable','Give and receive feedback with an open mind and heart'],\n       commitments:['I drive performance results by identifying metrics that matter, making them visible, and tracking them consistently to stay focused and accountable for delivering results.','I address performance gaps with respect and clarity, offering timely feedback.','I recognize and celebrate excellence to inspire shared success.','I execute through people — by hiring smart and keeping top talent engaged.','I lead by example, holding myself and others to the highest standards.'],\n       funds:['execute','principle','feedback']}\n    ]\n  }\n};\nconst linesToList=t=>String(t||'').split('\\n').map(s=>s.trim()).filter(Boolean);\nconst titleish=s=>String(s||'').toLowerCase().replace(/\\b[a-z]/g,c=>c.toUpperCase());\nconst VALUE_COLORS=['#8A9A1D','#EFB024','#1F3A7A','#E4232A','#0E7C7B','#7A3E9D'];\n\n/* Turn a pasted (or extracted) block of text into value records.\n   Deliberately forgiving — the shapes people actually paste:\n     CARING RELATIONSHIPS | Empower | #8A9A1D   ← a heading starts a value\n     We approach relationships with…            ← first plain line is the statement\n     - Show compassion and empathy              ← bullets are team behaviors\n     I build strong, personal connections…      ← lines starting \"I \" are commitments\n     > Build Trust, Starfish Moments            ← which fundamentals it lives in\n   Leader word, color and fundamentals are all optional. */\nfunction parseValuesText(txt,mods){\n  const byName={};\n  (mods||[]).forEach(m=>{ byName[String(m.name).toLowerCase()]=m.id; byName[m.id]=m.id; });\n  const out=[]; let cur=null;\n  String(txt||'').split(/\\r?\\n/).forEach(raw=>{\n    let line=raw.trim(); if(!line) return;\n    const hashed=/^#{1,3}\\s+/.test(line);\n    const shouty=line===line.toUpperCase()&&/[A-Z]{3}/.test(line)&&line.length<60&&!/^[-•*]/.test(line);\n    if(hashed||shouty){\n      const parts=line.replace(/^#{1,3}\\s+/,'').split('|').map(s=>s.trim());\n      const col=(parts[2]||'').trim();\n      cur={name:titleish(parts[0]), edge:parts[1]?titleish(parts[1]):'',\n        color:/^#[0-9a-fA-F]{6}$/.test(col)?col:VALUE_COLORS[out.length%VALUE_COLORS.length],\n        statement:'', behaviors:[], commitments:[], funds:[]};\n      out.push(cur); return;\n    }\n    if(!cur) return;\n    if(/^[>@]/.test(line)){\n      line.replace(/^[>@]\\s*/,'').split(',').forEach(n=>{\n        const id=byName[n.trim().toLowerCase()];\n        if(id&&cur.funds.indexOf(id)<0) cur.funds.push(id); });\n      return;\n    }\n    const bulleted=/^[-•*]\\s*/.test(line);\n    line=line.replace(/^[-•*]\\s*/,'');\n    if(/^I\\s/.test(line)) cur.commitments.push(line);\n    else if(bulleted) cur.behaviors.push(line);\n    else if(!cur.statement) cur.statement=line;\n    else cur.behaviors.push(line);\n  });\n  return out.filter(v=>v.name);\n}\n// An organization can pin its cohort to a list of addresses. Split on commas,\n// semicolons, whitespace or newlines so a pasted column or row both work.\nfunction parseEmails(txt){\n  return String(txt||'').split(/[\\s,;]+/).map(s=>s.trim().toLowerCase())\n    .filter(s=>/.+@.+\\..+/.test(s))\n    .filter((s,i,a)=>a.indexOf(s)===i);\n}\nconst cleanCode=s=>String(s||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,12);\nconst fmtDate=ts=>new Date(ts).toLocaleDateString(undefined,{month:'short',day:'numeric'});\nconst fmtFull=ts=>new Date(ts).toLocaleDateString(undefined,{month:'long',day:'numeric',year:'numeric'});\nconst initials=n=>String(n||'').trim().split(/\\s+/).slice(0,2).map(p=>(p[0]||'').toUpperCase()).join('');\nfunction nextWeeklySlot(from,weekday,hour){ const d=new Date(from); d.setHours(hour||8,0,0,0);\n  let add=((weekday==null?1:weekday)-d.getDay()+7)%7; if(add===0&&d.getTime()<=from) add=7; d.setDate(d.getDate()+add); return d.getTime(); }\n\n// ---- tool stats, mirroring the desktop playbook ----\n// weekly/monthly stay locked until a leader has 7 days of history\nfunction daysTracked(hist){ if(!hist.length) return 0;\n  const oldest=hist[hist.length-1].ts||Date.now();\n  return Math.floor((Date.now()-oldest)/DAY)+1; }\n// entries saved by the web playbook use `total`/`frogs`; normalize both shapes\nfunction normNum(h){ if(typeof h.num==='number') return h.num;\n  if(typeof h.total==='number') return h.total;\n  const n=parseFloat(h.total); return isNaN(n)?null:n; }\nfunction normFrog(h){\n  if(typeof h.logged==='number') return {logged:h.logged,eaten:h.eaten||0};\n  if(Array.isArray(h.frogs)){ const l=h.frogs.filter(f=>f&&String(f.t||f.text||'').trim());\n    return {logged:l.length,eaten:l.filter(f=>f.d||f.done).length}; }\n  const m=String(h.total||'').match(/^(\\d+)\\s*\\/\\s*(\\d+)$/);\n  return m?{logged:+m[2],eaten:+m[1]}:null;\n}\nfunction toolAvgStats(hist){\n  hist=(hist||[]).map(h=>Object.assign({},h,{num:normNum(h),ts:h.ts||Date.parse(h.date)||Date.now()})).filter(h=>typeof h.num==='number');\n  if(!hist.length) return {daily:null,weekly:null,monthly:null,unlocked:false,days:0};\n  const now=Date.now(), days=daysTracked(hist), unlocked=days>=7;\n  const avgOf=a=>a.length?a.reduce((n,h)=>n+h.num,0)/a.length:null;\n  const recent=new Date(hist[0].ts).toDateString();\n  return {daily:avgOf(hist.filter(h=>new Date(h.ts).toDateString()===recent)),\n    weekly:unlocked?avgOf(hist.filter(h=>now-h.ts<=7*DAY)):null,\n    monthly:unlocked?avgOf(hist.filter(h=>now-h.ts<=30*DAY)):null, unlocked, days};\n}\nfunction frogStats(hist){\n  hist=(hist||[]).map(h=>{const n=normFrog(h);return n?Object.assign({},h,n,{ts:h.ts||Date.parse(h.date)||Date.now()}):null;}).filter(Boolean);\n  if(!hist.length) return {streak:0,weekRate:null,monthRate:null,unlocked:false,days:0};\n  const now=Date.now(), days=daysTracked(hist), unlocked=days>=7;\n  let streak=0;\n  for(let i=0;i<hist.length;i++){\n    const h=hist[i];\n    if(!(h.logged>0&&h.eaten===h.logged)) break;\n    if(i===0){ streak=1; continue; }\n    const p=new Date(hist[i-1].ts); p.setHours(0,0,0,0);\n    const c=new Date(h.ts); c.setHours(0,0,0,0);\n    if(Math.round((p-c)/DAY)===1) streak++; else break;\n  }\n  const rate=a=>{ let l=0,e=0; a.forEach(h=>{l+=h.logged;e+=h.eaten;}); return l?Math.round(e/l*100):null; };\n  return {streak, weekRate:unlocked?rate(hist.filter(h=>now-h.ts<=7*DAY)):null,\n    monthRate:unlocked?rate(hist.filter(h=>now-h.ts<=30*DAY)):null, unlocked, days};\n}\n\n/* ---- What success means, per tool ------------------------------------------\n   Only the scored trackers hand us a number. Everything else has its own\n   definition of a good fortnight: frogs actually eaten, starfish moments\n   created, champions caught, days the bamboo got watered, routines closed out.\n   This normalises all of them onto the same 0–10 so they can be read together\n   — and each carries a plain-English basis line so the number is never a\n   black box. Returns null when there is genuinely nothing to judge. */\nfunction toolPerf(mod,hist,fromTs,toTs){\n  const cfg=(mod&&mod.recurringTool)||{};\n  const inWin=(hist||[]).filter(h=>{ const ts=h.ts||Date.parse(h.date)||0;\n    return ts&&ts>=fromTs&&(toTs==null||ts<toTs); });\n  const spanDays=Math.max(1,Math.round(((toTs==null?Date.now():toTs)-fromTs)/DAY));\n  const dayset={}; inWin.forEach(h=>{ dayset[dayStart(h.ts||Date.parse(h.date)||0)]=1; });\n  const activeDays=Object.keys(dayset).length;\n  const clamp=n=>Math.max(0,Math.min(10,n));\n  const rate=(n,per)=>clamp(n/(spanDays*per)*10);\n\n  if(cfg.type==='tracker'){\n    const dims=(cfg.dimensions||[]).length;\n    const mx=(dims?dims*(cfg.max||10):(cfg.max||10))||10;\n    const ns=inWin.map(h=>Number(h.num!=null?h.num:h.total)).filter(n=>!isNaN(n));\n    if(!ns.length) return null;\n    const avg=ns.reduce((a,b)=>a+b,0)/ns.length;\n    return {val:clamp(avg/mx*10),\n      basis:'averaged '+(Math.round(avg*10)/10)+' of '+mx+' across '+ns.length+' score'+(ns.length===1?'':'s')};\n  }\n  if(cfg.type==='frog'){\n    let logged=0,eaten=0;\n    inWin.forEach(h=>{ const n=normFrog(h); if(n){ logged+=n.logged; eaten+=n.eaten; } });\n    if(!logged) return null;\n    // eating what you put on the plate matters more than how much you listed\n    const done=eaten/logged, pace=Math.min(1,eaten/spanDays);\n    return {val:clamp((done*7+pace*3)),\n      basis:eaten+' of '+logged+' frogs eaten'};\n  }\n  if(cfg.type==='deepwork'){\n    const ns=inWin.map(h=>Number(h.num)).filter(n=>!isNaN(n));\n    if(!ns.length) return null;\n    const avg=ns.reduce((a,b)=>a+b,0)/ns.length;\n    const kept=inWin.filter(h=>/finished/i.test(h.detail||'')).length;\n    return {val:clamp(avg*0.7+Math.min(1,ns.length/spanDays)*10*0.3),\n      basis:ns.length+' block'+(ns.length===1?'':'s')+', focus '+(Math.round(avg*10)/10)\n        +(kept?(' \\u00b7 '+kept+' finished'):'')};\n  }\n  if(cfg.type==='routine'){\n    // two routines a day is the ceiling\n    if(!inWin.length) return null;\n    return {val:rate(inWin.length,2),\n      basis:inWin.length+' routine'+(inWin.length===1?'':'s')+' closed out'};\n  }\n  if(cfg.type==='bamboo'){\n    if(!activeDays) return null;\n    return {val:rate(activeDays,1), basis:'watered '+activeDays+' of '+spanDays+' days'};\n  }\n  if(cfg.type==='ledger'){\n    let dep=0,wd=0;\n    inWin.forEach(h=>{ const d=String(h.detail||'');\n      dep+=(d.match(/\\+\\s/g)||[]).length; wd+=(d.match(/\\u2212\\s|-\\s/g)||[]).length; });\n    if(!dep&&!wd) return null;\n    // a healthy account is mostly deposits, and is visited often\n    const ratio=dep/Math.max(1,dep+wd);\n    return {val:clamp(ratio*7+Math.min(1,activeDays/spanDays)*10*0.3),\n      basis:dep+' deposit'+(dep===1?'':'s')+(wd?(', '+wd+' withdrawal'+(wd===1?'':'s')):'')};\n  }\n  if(cfg.type==='pentagon'){\n    const st=(mod&&mod.__st)||{};\n    const filled=Object.keys(st.values||{}).filter(k=>String((st.values||{})[k]||'').trim()).length;\n    if(!filled) return null;\n    return {val:clamp(filled/5*10), basis:filled+' of 5 principles named'};\n  }\n  // 'log' and anything new: showing up is the measure\n  if(!inWin.length) return null;\n  return {val:rate(inWin.length,1),\n    basis:inWin.length+' logged over '+spanDays+' days'};\n}\n// ---- streaks ----\n// Daily tools (scores, frogs) break the moment a day is missed. Log-style\n// tools are counted by week on purpose: a starfish moment or a buffalo moment\n// isn't a daily event, and a daily streak there would only ever read zero.\nconst STREAK_UNIT={tracker:'day',frog:'day',log:'week',ledger:'week',bamboo:'day'};\n// A tracker entry keeps its lines as \"Sleep 8 · Sweat 6 · …\". Reading them back\n// out is what lets us average one line (Sleep) across a person or an org.\nfunction dimAvgs(hist,dims){\n  const sums={},ns={};\n  (hist||[]).forEach(e=>{ String(e.detail||'').split('·').forEach(part=>{\n    const p=part.trim(); const mm=p.match(/^(.*?)[\\s:]+(\\d+(?:\\.\\d+)?)$/); if(!mm) return;\n    const key=dims.find(d=>d.toLowerCase()===mm[1].trim().toLowerCase()); if(!key) return;\n    sums[key]=(sums[key]||0)+Number(mm[2]); ns[key]=(ns[key]||0)+1; }); });\n  return dims.map(d=>({dim:d,avg:ns[d]?sums[d]/ns[d]:null,n:ns[d]||0}));\n}\nfunction toolTotals(hist){\n  return (hist||[]).map(e=>Number(e.num!=null?e.num:e.total)).filter(n=>!isNaN(n));\n}\n// Markers never run out: named ones early, then every hundred, forever. There is\n// no finish line to reach and stop at.\nconst MILES=[3,7,14,25,50,100,200,365];\nfunction nextMile(c){ const m=MILES.find(n=>c<n); return m||(Math.floor(c/100)+1)*100; }\nfunction prevMile(c){ let p=0; MILES.forEach(n=>{ if(n<=c) p=n; });\n  return c>=365?Math.max(365,Math.floor(c/100)*100):p; }\n// Cadence is set per tool, not per tool type. Some of these are daily habits;\n// others only mean something once a week, once a month, or twice a year.\nconst TOOL_UNIT={energy:'day',execute:'day',bamboo:'day',\n  ero:'week',feedback:'week',starfish:'week',\n  comm:'month',cast:'month',trust:'month',\n  principle:'half'};\nfunction unitOf(m){ if(!m||!m.recurringTool) return null;\n  return TOOL_UNIT[m.id]||STREAK_UNIT[m.recurringTool.type]||null; }\nconst UNIT_PERIOD={day:'today',week:'this week',month:'this month',half:'this half of the year'};\nfunction periodLabel(u){ return UNIT_PERIOD[u]||'today'; }\nfunction unitWord(u,n){ if(u==='half') return n===1?'six-month stretch':'six-month stretches';\n  const w=u==='week'?'week':(u==='month'?'month':'day'); return n===1?w:w+'s'; }\n// Start of the period a timestamp falls in, on the device's own clock.\nfunction periodStart(u,at){ const d=at?new Date(at):new Date(); d.setHours(0,0,0,0);\n  if(u==='week') d.setDate(d.getDate()-((d.getDay()+6)%7));\n  else if(u==='month') d.setDate(1);\n  else if(u==='half'){ d.setDate(1); d.setMonth(d.getMonth()<6?0:6); }\n  return d.getTime(); }\n// Sequence number of that period, so consecutive periods differ by exactly one\n// even when months and half-years are different lengths.\nfunction periodIndex(u,at){ const d=new Date(periodStart(u,at));\n  if(u==='month') return d.getFullYear()*12+d.getMonth();\n  if(u==='half') return d.getFullYear()*2+(d.getMonth()<6?0:1);\n  if(u==='week') return Math.round(d.getTime()/(7*DAY));\n  return Math.round(d.getTime()/DAY); }\n// Water the Bamboo lives in the toolkit on its own — it belongs to no single\n// fundamental and never locks, so it is a module the program does not carry.\nconst BAMBOO_MOD={id:'bamboo',name:'Water the Bamboo',order:0,items:[],\n  recurringTool:{type:'bamboo',title:'Water the Bamboo',\n    instructions:'Name one goal and water it. Nobody can tell you how long it takes — every watering goes into a root system you cannot see, and the growth comes when the roots can hold it.'}};\n/* Two more tools that belong to no single fundamental. Deep Work is triggered\n   by the leader choosing to protect the block — that choice is the discipline\n   being measured. The routines are the opposite: the app triggers them, at\n   times the leader sets, and the checklist is theirs to write. */\nconst DEEPWORK_MOD={id:'deepwork',name:'Deep Work Focus',order:0,items:[],\n  recurringTool:{type:'deepwork',title:'Deep Work Focus',\n    instructions:'Focused time you defend on purpose. Nobody schedules this for you \\u2014 choosing to protect the block, and staying in it, is the discipline being measured.'}};\n/* Optional scoring for the block. Every composition here is centuries out of\n   copyright, so no publisher or performing-rights society is owed anything for\n   the music itself. The RECORDINGS are a separate copyright: these are all\n   either released into the public domain (Musopen) or licensed CC BY / CC BY-SA\n   by the performers who made them, which permits commercial use but obliges us\n   to name the performer and link the licence. We do not hard-code those credits\n   — dwLoadCredits() reads them straight off Wikimedia's API at run time, so the\n   attribution shown is always the one the file actually carries. */\nconst DW_MEDIA='https://commons.wikimedia.org/wiki/Special:FilePath/';\nconst DW_PAGE='https://commons.wikimedia.org/wiki/File:';\nconst DW_API='https://commons.wikimedia.org/w/api.php?action=query&format=json&origin=*&prop=imageinfo&iiprop=extmetadata|size&titles=';\nconst DW_TRACKS=[\n  {title:'Air on the G String',composer:'Bach',note:'Slow, even, almost no dynamics',\n   use:'Working somewhere you cannot control \\u2014 lounge, hotel, open floor',\n   sci:'It never gets louder or faster, so your ear stops noticing it. That also makes it good at covering nearby talking, which pulls at you more than the music does.',\n   file:'Air.ogg'},\n  {title:'Brandenburg No. 3, I. Allegro',composer:'Bach',note:'Steady pulse, no surprises',\n   use:'Clearing the queue \\u2014 approvals, sign-offs, expenses, calendar triage',\n   sci:'Fast, but every bar is predictable. Nothing surprises you, so it fades into the background even though it moves quickly. Good for keeping a pace.',\n   file:'Bach_-_Brandenburg_Concerto_No._3_-_1._Allegro.ogg'},\n  {title:'The Four Seasons: Spring, I. Allegro',composer:'Vivaldi',note:'Bright and forward-moving',\n   performer:'John Harrison with the Wichita State University Chamber Players',\n   use:'The four o\\u2019clock slog \\u2014 status updates, trackers, pipeline hygiene',\n   sci:'The most energetic one here. Music mainly works by making you feel more awake, which helps when the job is boring and gets in the way when the job is genuinely hard.',\n   file:'Vivaldi_-_Four_Seasons_1_Spring_mvt_1_Allegro_-_John_Harrison_violin.oga'},\n  {title:'Canon in D',composer:'Pachelbel',note:'One figure, repeated',\n   use:'Repetitive review \\u2014 comp sheets, forecast rollups, scorecards',\n   sci:'The same short pattern, over and over. Because there is nothing new to follow, your head stays on the work instead of the music.',\n   file:\"Pachelbel's_Canon.ogg\"},\n  {title:'Eine kleine Nachtmusik, I. Allegro',composer:'Mozart',note:'Light, tidy, quick',\n   use:'Between meetings \\u2014 agenda prep, notes, delegation follow-ups',\n   sci:'You have almost certainly heard this before, and music you already know is easier to ignore than music you do not.',\n   file:'Mozart_-_Eine_kleine_Nachtmusik_-_1._Allegro.ogg'},\n  {title:'Piano Concerto No. 21, K. 467',composer:'Mozart',note:'Long lines, room to think',\n   use:'Strategy work \\u2014 annual planning, org design, a build-or-buy call',\n   sci:'This is the \"listen to Mozart and get smarter\" piece. That turned out not to be true \\u2014 researchers who checked it found no real gain. It is still calm and easy to work through, just not brain training.',\n   file:'Mozart_Piano_Concerto_N_21_in_C_major,_K._467.ogg'},\n  {title:'Moonlight Sonata, I. Adagio',composer:'Beethoven',note:'Quiet and unhurried',\n   use:'Writing that carries weight \\u2014 performance feedback, a board note',\n   sci:'Slow and still. Speed matters more than style \\u2014 slower music leaves you more room to hold a thought while you work it out.',\n   file:'Beethoven_Moonlight_1st_movement.ogg'},\n  {title:'Nocturne in E\\u266D, Op. 9 No. 2',composer:'Chopin',note:'Solo piano, wide dynamics',\n   use:'First drafts \\u2014 an all-hands narrative, a memo outline. For board packets and contracts, choose silence',\n   sci:'Lovely, but it keeps getting louder and softer, and that is exactly what pulls your eyes off a page. Keep it low, and turn it off if you are reading something you need to absorb.',\n   file:'Frederic_Chopin_-_Nocturne_Eb_major_Opus_9,_number_2.ogg'},\n  {title:'Gymnop\\u00e9die No. 1',composer:'Satie',note:'Sparse, nearly still',\n   use:'Numbers that have to be right \\u2014 the model, the budget, the deck before it ships',\n   sci:'As close to silence as music gets \\u2014 slow, quiet, mostly gaps. If the work is demanding but you still want something on, this gets in the way least.',\n   file:'Erik_Satie_-_gymnopedies_-_la_1_ere._lent_et_douloureux.ogg'}\n].map(t=>Object.assign({performer:''},t,{url:DW_MEDIA+t.file,page:DW_PAGE+t.file}));\nfunction dwStripHtml(s){ try{ const d=document.createElement('div'); d.innerHTML=String(s||'');\n  return (d.textContent||'').replace(/\\s+/g,' ').trim(); }catch(e){ return ''; } }\n/* What the research actually supports, stated plainly. Written this way on\n   purpose: the popular version of this topic is mostly myth, and a tool that\n   measures honesty about your own focus should not open with a sales pitch. */\nconst DW_SCIENCE=[\n  {h:'No words. Ever.',\n   b:'This is the one thing researchers agree on. Words in the music fight with the words in your head, so anything with singing hurts reading, writing and thinking. Everything on this list is instrumental.'},\n  {h:'It helps with boring work more than hard work',\n   b:'Music does not make you smarter. It makes you feel more awake, and feeling awake helps when the job is dull and repetitive. When the job already takes everything you have, music just takes some of it back.'},\n  {h:'If you are reading closely, use silence',\n   b:'Researchers pooled 65 studies and found any background sound \\u2014 noise, talking, or music \\u2014 makes reading a little worse. Not a lot, but consistently. So if this block is heavy reading or memorising, pick nothing.'},\n  {h:'Mozart does not make you smarter',\n   b:'You may have heard that playing Mozart raises your IQ. It does not. When researchers reviewed all the studies together, the effect disappeared. The original finding was just people feeling more alert for a few minutes.'},\n  {h:'Three things separate good from bad',\n   b:'Music that stays the same is easier to ignore than music that swells and surprises. Music you already know is easier to ignore than music you do not. And quiet is easier than loud. That is what the notes on each track below are telling you.'},\n  {h:'Trust your scores, not your gut',\n   b:'People regularly say music is helping them while their results say otherwise. So do not take our word for it. Run one block silent, run the next one with something on, and compare the focus scores you gave yourself.'}\n];\n/* The four marks a block is measured against. They are not rewards — each one\n   names what is actually true at that point of the clock. */\nconst DW_MILES=[null,\n  {pct:'25%',head:'A quarter of the way in',body:'The hardest part is already behind you. You started, and you have not left.'},\n  {pct:'50%',head:'Halfway',body:'Everything that pulled at you in the first minute has passed on its own. Nothing needed you.'},\n  {pct:'75%',head:'Three quarters',body:'Do not spend the last stretch tidying up. Put the minutes that are left into the work itself.'}];\nconst ROUTINE_MOD={id:'routine',name:'Start Up / Shut Down',order:0,items:[],\n  recurringTool:{type:'routine',title:'Start Up / Shut Down',\n    instructions:'Two routines, written by you, triggered by the app. How you open the day and how you close it decide most of what happens in between.'}};\nconst ROUTINE_DEFAULT={\n  su:['Review the top three for today','Ten minutes on the hardest thing first','Check nothing overnight needs me'],\n  sd:['Close the loops I opened today','Write tomorrow\\u2019s top three','Shut the laptop \\u2014 the day is done']};\nconst BAMBOO_STORY=[\n  {year:'Plant',text:'A farmer plants a giant timber bamboo seed, waters it, and waits.'},\n  {year:'Water',text:'Season after season she keeps watering. Nothing appears above ground.'},\n  {year:'Roots',text:'All of it is going somewhere — an enormous root system, out of sight.'},\n  {year:'Rise',text:'When it does sprout it grows ninety feet in sixty days, because the roots were ready for it.'}];\n// Every \"is this today / this week\" question resolves against the device's own\n// clock, so a new day starts at 12:00am wherever the user actually is.\nfunction dayStart(at){ const d=at?new Date(at):new Date(); d.setHours(0,0,0,0); return d.getTime(); }\nfunction msToMidnight(){ const d=new Date(); d.setHours(24,0,0,0); return Math.max(1000,d.getTime()-Date.now()); }\nfunction streakOf(hist,unit){\n  const stamps=(hist||[]).map(h=>h.ts||Date.parse(h.date)||0).filter(Boolean);\n  if(!stamps.length) return {current:0,best:0,unit:unit,active:false,total:0};\n  const key=ts=>periodIndex(unit,ts);\n  const seen={}, periods=[];\n  stamps.forEach(ts=>{ const k=key(ts); if(!seen[k]){ seen[k]=1; periods.push(k); } });\n  periods.sort((a,b)=>b-a);\n  const nowK=key(Date.now()), gap=nowK-periods[0];\n  let current=0;\n  // A streak stays alive through the current period and one grace period —\n  // you haven't lost Tuesday's streak just because it's Wednesday morning.\n  if(gap<=1){\n    current=1;\n    for(let i=1;i<periods.length;i++){\n      if(periods[i-1]-periods[i]===1) current++; else break;\n    }\n  }\n  let best=1, run=1;\n  for(let i=1;i<periods.length;i++){\n    run=periods[i-1]-periods[i]===1?run+1:1;\n    if(run>best) best=run;\n  }\n  return {current,best,unit,active:periods[0]===nowK,total:periods.length};\n}\nfunction statCards(defs,days){\n  return defs.map(d=>({label:d.label,\n    value:d.locked?'🔒':(d.value==null?'—':d.value+(d.suffix||'')),\n    cardStyle:'flex:1;min-width:96px;background:'+(d.locked?'#EAF1F8':'#fff')+';border:1px solid #DCE6F0;border-radius:12px;padding:13px 10px;text-align:center',\n    valueStyle:'font-weight:900;font-size:22px;line-height:1.1;color:'+(d.locked?'#9DAAB8':'#D4B400'),\n    note:d.locked?(7-days)+' more day'+((7-days)===1?'':'s'):''}));\n}\n\n/* ============================================================\n   THE TWIN THIEVES — AUDIOBOOK\n   ------------------