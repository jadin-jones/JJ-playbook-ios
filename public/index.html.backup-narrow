.newOrgName.trim(); if(!name) return this.toast('Enter a name',true);\n    let code=cleanCode(this.state.newOrgCode);\n    if(!code){ const L='ABCDEFGHJKLMNPQRSTUVWXYZ',D='23456789'; code=''; for(let j=0;j<3;j++)code+=L[Math.floor(Math.random()*26)]; for(let j=0;j<3;j++)code+=D[Math.floor(Math.random()*8)]; }\n    if(await sget('org:'+code)) return this.toast('That code is taken',true);\n    const start=this.state.newOrgStart?new Date(this.state.newOrgStart+'T00:00:00').getTime():Date.now();\n    const org={code,name,cohort:this.state.newOrgCohort.trim(),startDate:start,group:'Active cohorts',createdAt:Date.now()};\n    const ok=await sset('org:'+code,org);\n    if(!ok) return this.toast('Could not save',true);\n    this.setState({orgList:this.state.orgList.concat([org]).sort((a,b)=>a.name.localeCompare(b.name)),newOrgName:'',newOrgCode:'',newOrgCohort:'',newOrgStart:''});\n    this.toast('Created '+name+' · '+code);\n  }\n  // Cut one block out of the home pyramid: same coordinate system, cropped to\n  // that block's bounding box so it can sit at the top of the fundamental.\n  triSlice(fm){\n    const mods=this.modules?this.modules():((this.state.program&&this.state.program.modules)||[]);\n    const tier=fm.tier||1;\n    const AX=150,AY=10,BR=290,BY=250;\n    const xAt=(y,side)=>AX+side*(BR-AX)*((y-AY)/(BY-AY));\n    const ROW={3:[AY,90],2:[90,170],1:[170,BY]};\n    const [y0,y1]=ROW[tier]||ROW[1];\n    const list=mods.filter(m=>(m.tier||1)===tier);\n    const i=Math.max(0,list.findIndex(m=>m.id===fm.id)), n=list.length||1;\n    const lt=xAt(y0,-1),rt=xAt(y0,1),lb=xAt(y1,-1),rb=xAt(y1,1);\n    const st=(rt-lt)/n, sb=(rb-lb)/n;\n    const x0t=lt+i*st,x1t=lt+(i+1)*st,x0b=lb+i*sb,x1b=lb+(i+1)*sb;\n    const pts=(n===1)\n      ? [[AX,AY],[x1b,y1],[x0b,y1]]\n      : [[x0t,y0],[x1t,y0],[x1b,y1],[x0b,y1]];\n    const xs=pts.map(p=>p[0]), ys=pts.map(p=>p[1]);\n    const pad=4;\n    const minX=Math.min.apply(null,xs)-pad, minY=Math.min.apply(null,ys)-pad;\n    const w=Math.max.apply(null,xs)-minX+pad, h=Math.max.apply(null,ys)-minY+pad;\n    const isz=Math.min(w,h)*0.44;\n    return {hasTri:true,\n      triPoints:pts.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' '),\n      triBox:minX.toFixed(1)+' '+minY.toFixed(1)+' '+w.toFixed(1)+' '+h.toFixed(1),\n      triFill:BRAND_TIER[tier]||BRAND_TIER[1],\n      triIx:(minX+w/2-isz/2).toFixed(1), triIy:(minY+h/2-isz/2).toFixed(1),\n      triIsz:isz.toFixed(1)};\n  }\n  // Probe a fundamental's pyramid slice once and remember whether it is there,\n  // so a missing file simply renders nothing instead of a broken image.\n  triReady(id){\n    this._tri=this._tri||{};\n    if(this._tri[id]===undefined){\n      this._tri[id]=false;\n      const im=new Image();\n      im.onload=()=>{ this._tri[id]=true; this.forceUpdate(); };\n      im.onerror=()=>{ this._tri[id]=false; };\n      im.src='assets/tri-'+id+'.png';\n    }\n    return this._tri[id];\n  }\n  // Logos are stored inline on the org record, so they are scaled down to a\n  // header-sized PNG first — a full-resolution file would blow the doc limit.\n  async uploadOrgLogo(code,file,field){\n    field=field||'logoUrl';\n    const wide=field==='coverUrl';\n    // A values poster is read, not glanced at, so it gets the largest budget.\n    const poster=field==='valuesPoster';\n    if(!/^image\\//.test(file.type)) return this.toast('Pick an image file',true);\n    try{\n      const url=await new Promise((res,rej)=>{ const r=new FileReader();\n        r.onload=()=>res(r.result); r.onerror=rej; r.readAsDataURL(file); });\n      const img=await new Promise((res,rej)=>{ const i=new Image();\n        i.onload=()=>res(i); i.onerror=rej; i.src=url; });\n      const MW=poster?1400:(wide?1000:440),MH=poster?1800:(wide?520:160);\n      const k=Math.min(1,MW/img.width,MH/img.height);\n      const c=document.createElement('canvas');\n      c.width=Math.max(1,Math.round(img.width*k)); c.height=Math.max(1,Math.round(img.height*k));\n      const x=c.getContext('2d'); x.imageSmoothingQuality='high';\n      x.drawImage(img,0,0,c.width,c.height);\n      const out=(wide||poster)?c.toDataURL('image/jpeg',poster?0.78:0.72):c.toDataURL('image/png');\n      if(out.length>900000) return this.toast(poster?'That poster is too large — try a smaller export':'That image is too large — try a smaller file',true);\n      const patch={}; patch[field]=out;\n      await this.saveOrg(code,patch);\n      this.toast(poster?'Values poster saved':(wide?'Photograph saved':'Logo saved'));\n    }catch(e){ this.toast('Could not read that image',true); }\n  }\n  // The brand holds the screen for a beat while boot runs, then dissolves.\n  startSplash(){\n    if(this._splashT) return;\n    this._splashT=setTimeout(()=>{\n      this.setState({splashOut:true});\n      setTimeout(()=>this.setState({splash:false}),1080);\n    },2600);\n  }\n  editDraft(fn){\n    if(!this.adminOk('edit published content')) return;\n    const d=this.state.draftProgram; fn(d); this.setState({draftProgram:d}); }\n\n  // ---- Per-organization content overrides (program:override:CODE) ----\n  async loadOverride(code){\n    if(!code) return this.setState({contentOrg:'',ovDraft:null});\n    const ov=await sget(ovKey(this.state.edition||'y1',code));\n    this.setState({contentOrg:code,ovDraft:(ov&&typeof ov==='object')?ov:{}});\n  }\n  editOv(mid,fn){\n    if(!this.adminOk('edit this organization\\u2019s content')) return;\n    const ov=Object.assign({},this.state.ovDraft||{});\n    ov[mid]=ov[mid]||{}; ov[mid].items=ov[mid].items||{};\n    fn(ov[mid]);\n    this.setState({ovDraft:ov});\n  }\n  ovItem(mid,iid){ const o=this.state.ovDraft||{}; return (o[mid]&&o[mid].items&&o[mid].items[iid])||{}; }\n  ovMod(mid){ const o=this.state.ovDraft||{}; return o[mid]||{}; }\n  /* Publishing pushes content to every leader's phone, so it asks for the\n     access phrase again first. A long Studio session leaves the tab open and\n     logged in; this makes the last step deliberate rather than a stray click. */\n  askPublish(kind){ this.setState({pubGate:kind,pubPass:'',pubErr:''}); }\n  confirmPublish(){\n    const s=this.state;\n    if((s.pubPass||'').trim().toUpperCase()!==ADMIN_HINT)\n      return this.setState({pubErr:'That access phrase is not right.'});\n    const kind=s.pubGate;\n    this.setState({pubGate:null,pubPass:'',pubErr:''});\n    if(kind==='org') this.publishOverride(); else this.publish();\n  }\n  async publishOverride(){\n    const s=this.state, code=s.contentOrg; if(!code) return;\n    this.setState({ovBusy:true});\n    const ok=await sset(ovKey(s.edition||'y1',code),s.ovDraft||{});\n    this.setState({ovBusy:false});\n    this.toast(ok?'Saved for '+code+' only':'Could not save',!ok);\n  }\n  async resetOverrideModule(mid){\n    if(!window.confirm('Reset this fundamental back to the master content for this organization?')) return;\n    const ov=Object.assign({},this.state.ovDraft||{});\n    delete ov[mid];\n    this.setState({ovDraft:ov});\n    const ok=await sset(ovKey(this.state.edition||'y1',this.state.contentOrg),ov);\n    this.toast(ok?'Back to master content':'Could not save',!ok);\n  }\n  async publish(){\n    const d=this.state.draftProgram; if(!d) return;\n    const ed=this.state.edition||'y1';\n    const claims=d.edition||'y1';\n    if(claims!==ed) return this.toast('That draft belongs to '+edLabel(claims)+' — start '+edShort(ed)+' from its own tab first',true);\n    if(!(d.modules||[]).length) return this.toast('Nothing to publish yet',true);\n    this.setState({publishing:true});\n    d.updatedAt=Date.now();\n    const ok=await sset(progKey(ed),d);\n    this.setState({publishing:false,program:(ok&&ed==='y1')?JSON.parse(JSON.stringify(d)):this.state.program});\n    this.toast(ok?(edLabel(ed)+' published'):'Could not publish',!ok);\n  }\n  // Fundamentals are program modules. Tier decides which row of the pyramid it\n  // sits on; order decides which month it opens. Both are editable, so a second\n  // Incredible Communication can sit beside the first.\n  /* Merge Y1_CONTENT into the draft. Matched by fundamental name, so running it\n     twice refreshes rather than duplicating; videos and thumbnails already set\n     in Studio are never touched. */\n  importY1(){\n    let added=0, updated=0, removed=0, kept0=0;\n    this.editDraft(d=>{\n      d.modules=d.modules||[];\n      /* Names drift (\"Energy\" vs \"Fundamental #1: Energy\"), so an existing\n         fundamental is claimed on a loose match — exact name first, then the\n         name with its numbering and punctuation stripped, then its icon. That\n         keeps item ids, and therefore submitted answers, attached. */\n      const norm=s=>String(s||'').toLowerCase()\n        .replace(/fundamental\\s*#?\\d*\\s*:?/g,'')\n        .replace(/introduction\\s*[—–-]*/g,'')\n        .replace(/[^a-z0-9+=]/g,'');\n      const pool=d.modules.slice();\n      const claim=src=>{\n        let i=pool.findIndex(x=>(x.name||'').trim().toLowerCase()===src.name.trim().toLowerCase());\n        if(i<0) i=pool.findIndex(x=>norm(x.name)===norm(src.name));\n        if(i<0) i=pool.findIndex(x=>(x.iconKey||'')===src.iconKey);\n        return i<0?null:pool.splice(i,1)[0];\n      };\n      const built=[];\n      Y1_CONTENT.forEach(src=>{\n        let m=claim(src);\n        const isNew=!m;\n        if(isNew){ m={id:'fund-'+Math.random().toString(36).slice(2,10),\n          name:src.name, iconKey:src.iconKey||'energy',\n          tier:src.tier===undefined?1:src.tier, order:src.order,\n          pyramid:false, overview:'', items:[], activities:[]};\n          added++; }\n        else updated++;\n        m.name=src.name;\n        /* Level, position and pyramid placement belong to the program, not to\n           this content file — an existing fundamental keeps exactly where it\n           sits, so importing text never rearranges the pyramid. Only a\n           fundamental created here needs those set. */\n        if(isNew){ m.tier=src.tier===undefined?1:src.tier; m.order=src.order; }\n        built.push(m);\n        if(isNew) m.iconKey=src.iconKey||m.iconKey;\n        if(src.tier!==undefined) m.tier=src.tier;\n        if(src.order) m.order=src.order;\n        m.overview=src.overview||m.overview||'';\n        m.items=m.items||[];\n        // Same idea one level down: claim an existing activity of that kind so\n        // its video survives, then keep only the activities this content lists.\n        const ipool=m.items.slice(), kept=[];\n        (src.items||[]).forEach((si,i)=>{\n          let ii=ipool.findIndex(x=>(x.kind||'')===si.kind\n            &&(x.title||'').trim().toLowerCase()===(si.title||'').trim().toLowerCase());\n          if(ii<0) ii=ipool.findIndex(x=>(x.kind||'')===si.kind);\n          let it=ii<0?null:ipool.splice(ii,1)[0];\n          if(!it){ it={id:'it-'+Math.random().toString(36).slice(2,10),\n            kind:si.kind, mediaUrl:'', posterUrl:'', videoEnabled:true, enabled:true,\n            resource:{title:'',url:'',note:'',enabled:false}, questions:[]};\n          }\n          kept.push(it);\n          it.title=si.title||''; it.len=si.len||'';\n          it.body=si.body||'';\n          it.instructions=si.instructions||'';\n          it.instructionsTitle=si.instructionsTitle||'';\n          it.instructionsEnabled=true;\n          if(si.challenge) it.challenge=Object.assign({},it.challenge||{},\n            {title:si.challenge.title||'',desc:si.challenge.desc||''});\n          // A handout the client supplied a real link for; anything they have\n          // attached themselves is left alone.\n          if(si.resource) it.resource=Object.assign({},it.resource||{},si.resource,{added:true});\n          // Questions are rewritten from the source, keeping ids where the text\n          // already matches so submitted answers stay attached.\n          const old=it.questions||[];\n          it.questions=(si.questions||[]).map((qt,qi)=>{\n            const prev=old.find(q=>(q.text||'').trim()===qt.trim())||old[qi];\n            // The 5 S's monthly reflection is scored, not written.\n            const choice=si.choices&&qi===0;\n            return {id:(prev&&prev.id)||('q-'+Math.random().toString(36).slice(2,8)),\n              text:qt, type:choice?'choice':((prev&&prev.type)||'text'),\n              options:choice?si.choices.slice():((prev&&prev.options)||[]), enabled:true};\n          });\n        });\n        removed+=ipool.length;\n        m.items=kept;\n      });\n      /* Anything still in the pool is a duplicate of something we just built —\n         a second \"The Twin Thieves\", an older \"Energy\". Before dropping it,\n         lift any video, thumbnail or handout off it onto the fundamental that\n         replaced it, so a duplicate never has to be kept just to keep its\n         media. Then the published program is exactly this content, in order. */\n      const keep=[];\n      pool.forEach(dup=>{\n        const target=built.find(b=>norm(b.name)===norm(dup.name))\n          ||built.find(b=>(b.iconKey||'')===(dup.iconKey||''));\n        /* Only a genuine duplicate of something we just built gets dropped.\n           A fundamental that is nothing like any of the twelve is the client's\n           own work — it is kept and moved to the end, never deleted. */\n        if(!target){ keep.push(dup); return; }\n        (dup.items||[]).forEach(di=>{\n          const ti=(target.items||[]).find(x=>(x.kind||'')===(di.kind||''));\n          if(!ti) return;\n          if(!ti.mediaUrl&&di.mediaUrl) ti.mediaUrl=di.mediaUrl;\n          if(!ti.posterUrl&&di.posterUrl) ti.posterUrl=di.posterUrl;\n          if(!ti.len&&di.len) ti.len=di.len;\n          const dr=di.resource||{}, tr=ti.resource||{};\n          if(!tr.url&&dr.url) ti.resource=Object.assign({},dr,{added:true});\n          const dc=di.challenge||{}, tc=ti.challenge||{};\n          if(!tc.videoUrl&&dc.videoUrl)\n            ti.challenge=Object.assign({},tc,{videoUrl:dc.videoUrl,posterUrl:dc.posterUrl||''});\n        });\n        removed++;\n      });\n      // Kept fundamentals keep their own level and position too.\n      d.modules=built.concat(keep);\n      kept0=keep.length;\n    });\n    this.toast(added+' added · '+updated+' refreshed'\n      +(removed?(' · '+removed+' duplicate'+(removed===1?'':'s')+' removed'):'')\n      +(kept0?(' · '+kept0+' of your own kept'):'')\n      +' — review, then Publish');\n  }\n  addFundamental(){\n    this.editDraft(d=>{\n      d.modules=d.modules||[];\n      const maxOrder=d.modules.reduce((a,m)=>Math.max(a,m.order||0),0);\n      d.modules.push({id:'fund-'+Math.random().toString(36).slice(2,10),\n        name:'New fundamental', iconKey:'energy', tier:1, order:maxOrder+1, pyramid:false,\n        overview:'', items:[], activities:[]});\n    });\n    this.toast('Fundamental added — name it and place it');\n  }\n  removeFundamental(mid){\n    this.editDraft(d=>{ d.modules=(d.modules||[]).filter(m=>m.id!==mid); });\n    this.setState({openModule:null});\n    this.toast('Fundamental removed');\n  }\n  duplicateFundamental(mid){\n    this.editDraft(d=>{\n      const i=(d.modules||[]).findIndex(m=>m.id===mid); if(i<0) return;\n      const copy=JSON.parse(JSON.stringify(d.modules[i]));\n      copy.id='fund-'+Math.random().toString(36).slice(2,10);\n      copy.name=(copy.name||'Untitled')+' II';\n      copy.iconKey=copy.iconKey||mid;\n      copy.pyramid=false;\n      // A duplicate is almost always the next part of what it came from.\n      copy.partOf=d.modules[i].partOf||mid;\n      copy.partLabel='Part 2';\n      if(!d.modules[i].partLabel) d.modules[i].partLabel='Part 1';\n      delete copy.lines;\n      (copy.items||[]).forEach(it=>{ it.id='it-'+Math.random().toString(36).slice(2,10);\n        (it.questions||[]).forEach(q=>{ q.id='q-'+Math.random().toString(36).slice(2,8); });\n        delete it.releaseAt; });\n      (copy.activities||[]).forEach(a=>{ a.id='act-'+Math.random().toString(36).slice(2,8); });\n      copy.order=(copy.order||0)+1;\n      d.modules.splice(i+1,0,copy);\n    });\n    this.toast('Fundamental duplicated');\n  }\n  // Drop a fundamental at a new place in the list. It takes the level of\n  // whatever it landed after, then every row is renumbered.\n  dropFundamental(dragId,overId){\n    if(!dragId||dragId===overId) return;\n    this.editDraft(d=>{\n      const all=d.modules||[];\n      const seq=all.slice().sort((a,b)=>((a.tier||0)-(b.tier||0))\n        ||(((a.slot!=null?a.slot:a.order||0))-((b.slot!=null?b.slot:b.order||0))));\n      const from=seq.findIndex(m=>m.id===dragId);\n      const to=seq.findIndex(m=>m.id===overId);\n      if(from<0||to<0) return;\n      const [x]=seq.splice(from,1);\n      seq.splice(to,0,x);\n      const at=seq.findIndex(m=>m.id===dragId);\n      const before=at>0?seq[at-1]:null, after=at<seq.length-1?seq[at+1]:null;\n      // Land in the level you were dropped into, not the one you came from.\n      if(before) x.tier=before.tier||0;\n      else if(after) x.tier=after.tier||0;\n      const byT={};\n      seq.forEach(m=>{ const t=m.tier||0; byT[t]=byT[t]||0; m.slot=byT[t]++; });\n    });\n    this.setState({dragFund:'',dragOverFund:''});\n  }\n  // Renumber the whole row so the slots stay dense and predictable.\n  moveFundamental(mid,dir){\n    this.editDraft(d=>{\n      const all=d.modules||[];\n      const me=all.find(m=>m.id===mid); if(!me) return;\n      const row=all.filter(m=>m.tier===me.tier)\n        .sort((a,b)=>((a.slot!=null?a.slot:a.order||0)-(b.slot!=null?b.slot:b.order||0)));\n      const i=row.findIndex(m=>m.id===mid), to=i+dir;\n      if(i<0||to<0||to>=row.length) return;\n      const [x]=row.splice(i,1); row.splice(to,0,x);\n      row.forEach((m,k)=>{ m.slot=k; });\n    });\n  }\n  patchFundamental(mid,patch){\n    this.editDraft(d=>{ const m=(d.modules||[]).find(x=>x.id===mid); if(m) Object.assign(m,patch); });\n  }\n  addItem(mid,kind){\n    this.editDraft(d=>{\n      const mm=d.modules.find(x=>x.id===mid); if(!mm) return;\n      mm.items=mm