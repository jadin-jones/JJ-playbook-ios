st n=parseInt(c.length===3?c.split('').map(x=>x+x).join(''):c,16);\n          if(!isNaN(n)){ const L=(0.2126*((n>>16)&255)+0.7152*((n>>8)&255)+0.0722*(n&255))/255;\n            if(L<0.42) nv='#C6D6EA'; } }\n        if(!nv) nv=M.bg[v.toLowerCase()];\n        if(!nv||nv===v) return;\n        el.__jjA=el.__jjA||{}; if(el.__jjA[at]===undefined) el.__jjA[at]=v;\n        el.setAttribute(at,nv); this._tSet.add(el);\n      });\n    }\n  }\n  unpaintTheme(){\n    (this._tSet||new Set()).forEach(el=>{\n      if(el.__jjT){ Object.keys(el.__jjT).forEach(p=>{ try{ el.style.setProperty(p,el.__jjT[p]); }catch(e){} }); el.__jjT=null; }\n      if(el.__jjA){ Object.keys(el.__jjA).forEach(a=>{ try{ el.setAttribute(a,el.__jjA[a]); }catch(e){} }); el.__jjA=null; }\n    });\n    this._tSet=new Set();\n  }\n  watchTheme(){\n    if(this._tObs||typeof MutationObserver==='undefined') return;\n    const root=document.getElementById('dc-root')||document.body; if(!root) return;\n    this._tObs=new MutationObserver(()=>{ if(this.state.theme!=='dark'||this._tRaf) return;\n      this._tRaf=requestAnimationFrame(()=>{ this._tRaf=0; this.paintTheme(); }); });\n    this._tObs.observe(root,{subtree:true,childList:true,attributes:true,attributeFilter:['style','fill','stroke']});\n  }\n  applyTheme(){\n    const on=this.state.theme==='dark';\n    try{ document.documentElement.style.background=on?'#0B1119':'';\n      document.documentElement.style.colorScheme=on?'dark':'';\n      if(document.body) document.body.style.background=on?'#0B1119':''; }catch(e){}\n    if(on){ this.paintTheme(); this.watchTheme(); } else this.unpaintTheme();\n  }\n  initTheme(){ let t='dark';\n    try{ t=localStorage.getItem('jj_theme')||'dark'; }catch(e){}\n    this.setState({theme:t},()=>this.applyTheme()); }\n  setTheme(t){ try{ localStorage.setItem('jj_theme',t); }catch(e){}\n    this.setState({theme:t},()=>this.applyTheme()); }\n  watchWidth(){\n    if(typeof window==='undefined'||!window.matchMedia||this._mq) return;\n    