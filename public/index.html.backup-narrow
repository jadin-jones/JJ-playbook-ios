ly exist pre-hydration. */\nsc-if,sc-for{display:none!important}\n@keyframes jjSplashOut{to{opacity:0;visibility:hidden}}\n@keyframes jjLogoSpin{0%{opacity:1;transform:rotate(0deg) scale(1)}20%{opacity:1;transform:rotate(26deg) scale(1.05)}45%{opacity:1;transform:rotate(150deg) scale(1.3)}70%{opacity:.9;transform:rotate(420deg) scale(1.9)}100%{opacity:0;transform:rotate(900deg) scale(3.4)}}\n<\/style>\n\n\n<\/helmet>\n<sc-if value=\"{{ splash.show }}\" hint-placeholder-val=\"{{ true }}\">\n<div style=\"{{ splash.style }}\">\n<img src=\"edf6010a-356c-4f90-8a88-830082fb1577\" alt=\"Jadin Jones\" style=\"{{ splash.logoStyle }}\">\n<div style=\"position:absolute;left:0;right:0;bottom:max(38px,env(safe-area-inset-bottom));text-align:center;font-family:Montserrat,sans-serif;font-weight:800;font-size:19px;letter-spacing:.28em;text-transform:uppercase;color:#FFFFFF;padding:0 24px 0 30px;text-shadow:0 1px 14px rgba(2,20,44,.85);animation:jjSplashIn .9s .35s cubic-bezier(.22,.9,.3,1) both\">www.jadin-jones.com<\/div>\n<\/div>\n<\/sc-if>\n<div style=\"{{ shellOuterStyle }}\">\n<div style=\"{{ shellStyle }}\">\n\n<header style=\"{{ headerStyle }}\">\n<div style=\"display:flex;align-items:center;gap:9px;min-width:0\">\n<img src=\"d3d700c0-61c6-47fc-8467-e0ebec3128f1\" alt=\"Jadin Jones\" style=\"height:28px;width:auto;display:block;flex:none\">\n<span style=\"font-weight:700;font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:#7E8D9C;line-height:1.3\">The Championship<br>Teams Playbook<\/span>\n<sc-if value=\"{{ hasOrgLogo }}\" hint-placeholder-val=\"{{ false }}\">\n<img src=\"{{ orgLogo }}\" alt=\"\" style=\"height:26px;width:auto;max-width:80px;object-fit:contain;background:#fff;border:1px solid #DCE6F0;border-radius:6px;padding:3px;flex:none\">\n<\/sc-if>\n<\/div>\n<div style=\"display:flex;align-items:center;gap:9px;flex:none\">\n<div style=\"text-align:right;line-height:1.25\">\n<div style=\"{{ whoKickerStyle }}\">{{ whoKicker }}<\/div>\n<div style=\"font-size:12px;font-weight:800;color:#0C1B2E\">{{ whoName }}<\/div>\n<\/div>\n<button sc-camel-on-click=\"{{ onSignOut }}\" style=\"{{ signOutStyle }}\">Sign out<\/button>\n<\/div>\n<\/header>\n\n<sc-if value=\"{{ previewMode }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"display:flex;align-items:center;gap:10px;background:#FFF0A6;border-bottom:1px solid #D4B400;padding:9px 14px;font-size:11.5px;color:#5C4A08;position:sticky;top:51px;z-index:29\">\n<span style=\"flex:1\">👀 Previewing as a member of {{ orgName }} — locks are off here.<\/span>\n<button sc-camel-on-click=\"{{ onExitPreview }}\" style=\"flex:none;background:#0C2647;color:#FFFFFF;border:none;border-radius:7px;padding:7px 12px;font-weight:800;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer\">Exit<\/button>\n<\/div>\n<\/sc-if>\n\n<main style=\"{{ mainStyle }}\">\n\n<sc-if value=\"{{ booting }}\" hint-placeholder-val=\"{{ true }}\">\n<div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:100px 24px;text-align:center\">\n<i style=\"width:34px;height:34px;border-radius:50%;border:3px solid #DCE6F0;border-top-color:#00A3E0;display:block;animation:jjSpin .8s linear infinite\"><\/i>\n<div style=\"font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#7E8D9C\">Connecting to your playbook<\/div>\n<\/div>\n<\/sc-if>\n\n<sc-if value=\"{{ showGate }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"padding:18px 12px 0;animation:jjIn .3s ease both\">\n<div style=\"background:#0C2647;border-radius:18px;padding:26px 18px 24px;text-align:center\">\n<img src=\"d3d700c0-61c6-47fc-8467-e0ebec3128f1\" alt=\"Jadin Jones\" style=\"height:46px;width:auto;display:block;margin:0 auto 16px;filter:brightness(0) invert(1)\">\n<h1 style=\"font-weight:900;font-size:30px;line-height:.98;margin:0;letter-spacing:-.5px;text-transform:uppercase;color:#FFFFFF\">The <span style=\"color:#FADA01\">Championship<br>Teams<\/span> Playbook<\/h1>\n<svg sc-camel-view-box=\"-62 4 364 256\" style=\"width:100%;height:auto;display:block;margin:16px 0 2px;overflow:visible\">\n<polygon points=\"150,10 10,250 -58,250\" fill=\"#0A1F3A\"><\/polygon>\n<sc-for list=\"{{ gateCells }}\" as=\"c\" hint-placeholder-count=\"9\">\n<g sc-camel-on-click=\"{{ c.onTap }}\" style=\"{{ c.gStyle }}\">\n<polygon points=\"{{ c.points }}\" fill=\"{{ c.fill }}\" stroke=\"rgba(255,255,255,.28)\" stroke-width=\"1\"><\/polygon>\n<image href=\"{{ c.icon }}\" x=\"{{ c.ix }}\" y=\"{{ c.iy }}\" width=\"{{ c.isz }}\" height=\"{{ c.isz }}\" sc-camel-preserve-aspect-ratio=\"xMidYMid meet\" style=\"pointer-events:none\"><\/image>\n<\/g>\n<\/sc-for>\n<sc-for list=\"{{ gateCellLabels }}\" as=\"l\" hint-placeholder-count=\"12\">\n<foreignObject x=\"{{ l.x }}\" y=\"{{ l.y }}\" width=\"{{ l.w }}\" height=\"{{ l.h }}\" style=\"overflow:visible;pointer-events:none\">\n<div style=\"{{ l.style }}\">{{ l.text }}<\/div>\n<\/foreignObject>\n<\/sc-for>\n<\/svg>\n<sc-if value=\"{{ gateHasSel }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"display:flex;align-items:flex-start;gap:12px;background:#0C2647;border-radius:13px;padding:13px 14px;margin:10px 0 16px;animation:jjIn .22s ease both\">\n<span style=\"width:40px;height:40px;flex:none;border-radius:10px;background:#FADA01;display:flex;align-items:center;justify-content:center\"><img src=\"{{ gateSelIcon }}\" alt=\"\" style=\"width:24px;height:24px;object-fit:contain\"><\/span>\n<span style=\"min-width:0\">\n<span style=\"display:block;font-weight:800;font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:#6FC0EA\">{{ gateSelTier }}<\/span>\n<span style=\"display:block;font-weight:900;font-size:16px;line-height:1.15;text-transform:uppercase;color:#FFFFFF;margin-top:3px\">{{ gateSelName }}<\/span>\n<span style=\"display:block;font-size:13px;line-height:1.5;color:#7E8D9C;margin-top:5px\">{{ gateSelBlurb }}<\/span>\n<\/span>\n<\/div>\n<\/sc-if>\n<sc-if value=\"{{ gateNoSel }}\" hint-placeholder-val=\"{{ true }}\">\n<p style=\"text-align:center;font-size:13px;line-height:1.55;color:#7E8D9C;margin:10px 4px 14px\">Nine fundamentals of leadership — learned for yourself, then led with your team. One block at a time, all the way to the top.<\/p>\n<\/sc-if>\n<sc-if value=\"{{ gateWelcomeBack }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"animation:jjIn .3s ease both\">\n<p style=\"text-align:center;font-weight:900;font-size:18px;line-height:1.2;text-transform:uppercase;color:#FFFFFF;margin:14px 0 16px\">Hey! Welcome back, {{ knownLeaderName }}.<\/p>\n<button sc-camel-on-click=\"{{ onResume }}\" style=\"display:block;width:100%;max-width:260px;margin:0 auto;background:#FADA01;color:#0C2647;border:2px solid #FADA01;border-radius:999px;padding:16px;font-weight:900;font-size:14px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;box-shadow:0 6px 22px rgba(250,218,1,.45)\">{{ resumeCta }}<\/button>\n<p style=\"text-align:center;font-size:13px;color:#7E8D9C;margin:14px 0 0\">Not you? <button sc-camel-on-click=\"{{ onUseDifferentCode }}\" style=\"background:none;border:none;padding:0;font:inherit;color:#FFFFFF;text-decoration:underline;cursor:pointer\">Enter a different code<\/button><\/p>\n<button sc-camel-on-click=\"{{ onGoStudio }}\" style=\"display:block;width:100%;text-align:center;margin-top:22px;background:none;border:none;font-size:11.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#7E8D9C;cursor:pointer;padding:8px\">Studio access →<\/button>\n<\/div>\n<\/sc-if>\n<sc-if value=\"{{ gateShowForm }}\" hint-placeholder-val=\"{{ true }}\">\n<div>\n<p style=\"color:#7E8D9C;font-size:13.5px;line-height:1.6;margin:14px 0 18px\">Sign in with the code from your organization. Your progress syncs with the web playbook automatically.<\/p>\n<div style=\"background:#fff;border:1px solid #DCE6F0;border-radius:14px;padding:18px;text-align:left\">\n<sc-for list=\"{{ joinFields }}\" as=\"jf\" hint-placeholder-count=\"4\