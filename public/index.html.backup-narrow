the app ------------------------------\n     Every change to a running block is written to the same server record the\n     rest of the app saves to, so closing the tab, force-quitting, or picking\n     the phone up after starting on a laptop all land on the same block. The\n     app never resumes a block by itself — it hands it back paused and lets the\n     leader restart the clock on purpose. */\n  dwDevice(){ try{ const ua=navigator.userAgent||'';\n      if(/iPad|Tablet/i.test(ua)) return 'a tablet';\n      if(/iPhone|Android.*Mobile|Mobile/i.test(ua)) return 'a phone';\n      return 'a computer'; }catch(e){ return 'another device'; } }\n  dwPersist(patch){\n    const s=this.state;\n    if(s.dwPhase!=='running'){ this.setTool('deepwork',{live:null}); this.saveResp(); return; }\n    const live=Object.assign({\n      intent:s.dwRanIntent||'', mins:s.dwRanMins||90, track:s.dwTrack,\n      mile:s.dwMile||0, pauseCount:s.dwPauseCount||0, added:s.dwAdded||0,\n      paused:!!s.dwPaused, endsAt:s.dwEndsAt||0,\n      remainMs:s.dwPaused?(s.dwRemainMs||0):Math.max(0,(s.dwEndsAt||0)-Date.now()),\n      device:this.dwDevice(), updatedAt:Date.now()\n    },patch||{});\n    this.setTool('deepwork',{live});\n    this.saveResp();\n  }\n  /* Called once the leader's record has loaded, on this device or any other. */\n  dwRestore(){\n    const live=(this.toolState('deepwork')||{}).live;\n    if(!live||this.state.dwPhase==='running') return;\n    const remain=live.paused?(live.remainMs||0):Math.max(0,(live.endsAt||0)-Date.now());\n    if(remain<=1000){ this.setTool('deepwork',{live:null}); this.saveResp(); return; }\n    const sameDevice=live.device===this.dwDevice();\n    this.setState({dwPhase:'running',dwPaused:true,dwRemainMs:remain,\n      dwEndsAt:Date.now()+remain, dwNow:Date.now(),\n      dwRanIntent:live.intent||'', dwRanMins:live.mins||90,\n      dwMins:live.mins||90, dwIntent:live.intent||'',\n      dwMile:live.mile||0, dwTrack:(live.track==null?null:live.track),\n      dwPauseCount:live.pauseCount||0, dwAdded:live.added||0,\n      dwQueue:[], dwQi:0, dwBroke:false, dwConfirmEnd:false, dwExtendOpen:false,\n      dwRecovered:sameDevice?'closed':'moved', dwFromDevice:live.device||'another device'});\n    this.dwPersist({paused:true,remainMs:remain});\n  }\n  /* A close, a force-quit or a backgrounded phone must not silently burn the\n     clock. pagehide is the last event we reliably get on both iOS and desktop. */\n  watchDeepWorkExit(){\n    if(typeof window==='undefined'||this._dwExit) return;\n    this._dwExit=(why)=>{ const s=this.state;\n      if(s.dwPhase!=='running'||s.dwPaused) return;\n      const remain=Math.max(0,(s.dwEndsAt||0)-Date.now());\n      clearInterval(this._dwT);\n      try{ if(this._au) this._au.pause(); }catch(e){}\n      this.setTool('deepwork',{live:Object.assign({},\n        (this.toolState('deepwork')||{}).live||{},\n        {paused:true,remainMs:remain,device:this.dwDevice(),\n         intent:s.dwRanIntent||'',mins:s.dwRanMins||90,mile:s.dwMile||0,\n         track:s.dwTrack,pauseCount:(s.dwPauseCount||0)+1,updatedAt:Date.now()})});\n      this.saveResp();\n      // Reflect it in the live UI too, so coming back shows a paused block\n      // rather than a clock that kept running while nobody was there.\n      this.setState({dwPaused:true,dwRemainMs:remain,dwNow:Date.now(),\n        dwAudioOn:false,dwPauseCount:(s.dwPauseCount||0)+1,\n        dwRecovered:(why==='left'?'left':'closed')});\n    };\n    this._dwHide=()=>{ if(document.visibilityState==='hidden') this._dwExit('left'); };\n    window.addEventListener('pagehide',()=>this._dwExit('closed'));\n    window.addEventListener('beforeunload',()=>this._dwExit('closed'));\n    document.addEventListener('visibilitychange',this._dwHide);\n  }\n  /* ---- Deep Work clock, milestones and optional scoring ------------------\n     One set of methods owns the block so the lock overlay and the tool screen\n     can never disagree about what pause or end means. */\n  dwStartTick(){\n    clearInterval(this._dwT);\n    this._dwT=setInterval(()=>{\n      const s=this.state;\n      if(s.dwPhase!=='running'||s.dwPaused) return;\n      if(Date.now()>=s.dwEndsAt){ clearInterval(this._dwT);\n        this.dwAudioStop();\n        try{ this._wake&&this._wake.release(); this._wake=null; }catch(e){}\n        this.dwFanfare();\n        try{ navigator.vibrate&&navigator.vibrate([80,60,80,60,200]); }catch(e){}\n        this.localNotify('Block defended',{id:'dw-'+Date.now(),\n          body:'You went the whole way. Score it while it is fresh.',go:'tool:deepwork'});\n        this.setTool('deepwork',{live:null}); this.saveResp();\n        return this.setState({dwPhase:'won',dwBroke:false,dwMile:4,dwNow:Date.now(),dwRecovered:null}); }\n      const ran=s.dwRanMins||90;\n      const pct=1-((s.dwEndsAt-Date.now())/(ran*60000));\n      const reached=pct>=.75?3:(pct>=.5?2:(pct>=.25?1:0));\n      if(reached>(s.dwMile||0)){ this.dwChime(); this.setState({dwMile:reached,dwNow:Date.now()});\n        setTimeout(()=>this.dwPersist(),0); }\n      else this.setState({dwNow:Date.now()});\n    },500);\n  }\n  dwPause(){ const s=this.state;\n    clearInterval(this._dwT); this.dwAudioPause();\n    const remain=Math.max(0,(s.dwEndsAt||0)-Date.now());\n    this.setState({dwPaused:true,dwPauseCount:(s.dwPauseCount||0)+1,\n      dwRemainMs:remain,dwNow:Date.now(),dwRecovered:null});\n    setTimeout(()=>this.dwPersist({paused:true,remainMs:remain}),0); }\n  dwResume(){ const s=this.state;\n    const endsAt=Date.now()+(s.dwRemainMs||0);\n    this.setState({dwPaused:false,dwEndsAt:endsAt,dwNow:Date.now(),dwRecovered:null});\n    this.dwStartTick(); this.dwAudioResume();\n    setTimeout(()=>this.dwPersist({paused:false,endsAt}),0); }\n  dwEnd(){ const s=this.state, ran=s.dwRanMins||90;\n    clearInterval(this._dwT); this.dwAudioStop();\n    try{ this._wake&&this._wake.release(); this._wake=null; }catch(e){}\n    const remain=s.dwPaused?(s.dwRemainMs||0):Math.max(0,(s.dw