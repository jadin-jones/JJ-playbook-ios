rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true && msConfirmed();
    }
    function userEmail() { return request.auth.token.email.lower(); }
    // Microsoft reports every address as verified, but any tenant's admin can
    // put any address on an account (nOAuth). A Microsoft sign-in counts only
    // once /api/ms-verify has confirmed the mailbox: msVerified/{uid} holds it.
    function msConfirmed() {
      return request.auth.token.firebase.sign_in_provider != 'microsoft.com'
        || (exists(/databases/$(database)/documents/msVerified/$(request.auth.uid))
          && get(/databases/$(database)/documents/msVerified/$(request.auth.uid)).data.email == userEmail());
    }
    // Admin never through Microsoft, even with a confirmed mailbox.
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'microsoft.com'
        && userEmail() in [
          'charlie@jadin-jones.com',
          'lucas@jadin-jones.com',
          'review@jadin-jones.com'
        ];
    }
    function memberDoc() { return /databases/$(database)/documents/members/$(userEmail()); }
    function isAnyMember() { return signedIn() && exists(memberDoc()); }
    function inOrg(code) { return isAnyMember() && code in get(memberDoc()).data.orgs; }

    match /members/{email} {
      allow read: if isAdmin() || (signedIn() && email == userEmail());
      allow write: if isAdmin();
    }

    match /jj_playbook/{docId} {
      function parts() { return docId.split(':'); }
      function kind() { return parts()[0]; }
      // org:CODE (including its leads list), events:CODE, updates:CODE:
      // program members read, only admins write.
      function perOrgKind() { return kind() in ['org','events','updates']; }
      function overrideDoc() { return kind() == 'program' && parts()[1] == 'override'; }
      // Content every member reads. knowledge:misses (the questions members
      // asked the AI coach) and demo: (test sends, which carry a push token)
      // are admin-only.
      function globalKind() {
        return (kind() == 'knowledge' && docId != 'knowledge:misses')
          || (kind() == 'program' && parts()[1] != 'override');
      }
      function personalKind() { return kind() in ['resp','coach','gin','push','awaymark','remindmark','unlockmark','dwinvitemark']; }
      function teamKind() { return kind() == 'chat'; }
      // peer:CODE:TOKEN. Old peer:TOKEN rounds have no program in the key, so
      // only admins (the migration) reach them.
      function peerKind() { return kind() == 'peer' && parts().size() == 3; }
      function revKind() { return kind() == 'rev'; }
      function isPreviewOrSample() { return docId.matches('.*:(__preview__|sample-[^:]*)'); }
      function ownsExisting() {
        return signedIn() && resource != null
          && resource.data.ownerEmail is string
          && resource.data.ownerEmail == userEmail();
      }
      function ownsIncoming() {
        return signedIn()
          && request.resource.data.ownerEmail is string
          && request.resource.data.ownerEmail == userEmail();
      }
      // ownerEmail never changes on an update (admins aside).
      function keepsOwner() { return request.resource.data.ownerEmail == resource.data.ownerEmail; }
      // A team round is readable by its whole program; an individual round,
      // or one without peerMode yet, only by its owner.
      function teamRound() { return resource.data.get('peerMode', '') == 'team'; }
      // peerToken must match the key; peerMode is 'peer' or 'team' and, once
      // set, never changes.
      function peerFieldsOk() {
        return request.resource.data.peerToken == parts()[2]
          && request.resource.data.peerMode in ['peer', 'team'];
      }
      function keepsPeerMode() {
        return !('peerMode' in resource.data) || request.resource.data.peerMode == resource.data.peerMode;
      }

      allow read: if isAdmin()
        || (perOrgKind() && inOrg(parts()[1]))
        || (overrideDoc() && inOrg(parts()[2]))
        || (globalKind() && isAnyMember())
        || (teamKind() && inOrg(parts()[1]))
        || (peerKind() && inOrg(parts()[1]) && (resource == null || ownsExisting() || teamRound()))
        || (isPreviewOrSample() && isAnyMember())
        // rev: a member may learn only that they have no tombstone; an
        // existing one is refused, which the app treats as revoked.
        || (revKind() && resource == null && inOrg(parts()[1]))
        || (personalKind() && resource == null && inOrg(parts()[1]))
        || (personalKind() && ownsExisting());
      allow create: if isAdmin()
        || (personalKind() && inOrg(parts()[1]) && ownsIncoming())
        || (peerKind() && inOrg(parts()[1]) && ownsIncoming() && peerFieldsOk())
        || (teamKind() && inOrg(parts()[1]));
      allow update: if isAdmin()
        || (personalKind() && ownsExisting() && ownsIncoming() && keepsOwner())
        || (peerKind() && inOrg(parts()[1]) && ownsExisting() && ownsIncoming() && keepsOwner()
          && peerFieldsOk() && keepsPeerMode())
        || (teamKind() && inOrg(parts()[1]));
      allow delete: if isAdmin()
        || (personalKind() && ownsExisting())
        || (peerKind() && ownsExisting());
    }

    // Written and read only by the Netlify functions (Admin SDK).
    match /msVerified/{uid}      { allow read, write: if false; }
    match /msVerifyPending/{uid} { allow read, write: if false; }
    match /rateLimits/{id}       { allow read, write: if false; }

    // Nothing in this app uses these two; they were open to every member.
    // Closed to admins until whatever uses them is known.
    match /tt_data/{docId}     { allow read, write: if isAdmin(); }
    match /jj_lifeplan/{docId} { allow read, write: if isAdmin(); }

    // ===== Twin Thieves Leadership: its own section. Nothing above changes. =====
    // Membership is ttmembers/{email}.orgs, never members/{email}, so a Twin
    // Thieves member gets nothing from the Playbook's rules above (inOrg and
    // isAnyMember read members/{email}). Admins are covered by isAdmin above.
    function ttMemberDoc() { return /databases/$(database)/documents/ttmembers/$(userEmail()); }
    function inTT(code) {
      return signedIn() && code in ['TT36', 'TT10'] && exists(ttMemberDoc())
        && code in get(ttMemberDoc()).data.orgs;
    }

    match /ttmembers/{email} {
      allow read: if isAdmin() || (signedIn() && email == userEmail());
      allow write: if isAdmin();
    }

    match /jj_playbook/{docId} {
      function tp() { return docId.split(':'); }
      function ttOwns() {
        return resource != null && resource.data.ownerEmail is string
          && resource.data.ownerEmail == userEmail();
      }
      function ttOwnsIncoming() {
        return request.resource.data.ownerEmail is string
          && request.resource.data.ownerEmail == userEmail();
      }
      // The lesson library: admin-edit (above), member-read.
      // org:TT36 / org:TT10: members read their own program (its code among it).
      // rev:: a member may learn only that they have no tombstone.
      // ttm:CODE:idkey: name, email and progress, owner-only.
      allow read: if (docId == 'ttlib:master' && (inTT('TT36') || inTT('TT10')))
        || (tp()[0] == 'org' && tp().size() == 2 && inTT(tp()[1]))
        || (tp()[0] == 'rev' && tp().size() == 3 && resource == null && inTT(tp()[1]))
        || (tp()[0] == 'ttm' && tp().size() == 3 && inTT(tp()[1]) && (resource == null || ttOwns()));
      allow create: if tp()[0] == 'ttm' && tp().size() == 3 && inTT(tp()[1]) && ttOwnsIncoming();
      allow update: if tp()[0] == 'ttm' && tp().size() == 3 && inTT(tp()[1]) && ttOwns() && ttOwnsIncoming()
        && request.resource.data.ownerEmail == resource.data.ownerEmail;
    }
  }
}
